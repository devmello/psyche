# Text files are LF everywhere, including Windows checkouts with core.autocrlf=true: generated
# files (`pnpm protocol:check`), golden fixtures and migration checksums compare bytes.
* text=auto eol=lf
# Windows scripts keep CRLF (cmd.exe and older PowerShell expect it).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

