{
  "sourceLanguage": "en",
  "strings": {
    "This file changed while it downloaded. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed while it downloaded. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف تغيّر أثناء التنزيل. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat sich während des Downloads geändert. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió mientras se descargaba. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé pendant le téléchargement. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल डाउनलोड होते समय बदल गई। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è cambiato durante il download. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード中にファイルが変更されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하는 동안 파일이 바뀌었습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo mudou durante o download. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在下载期间发生了变化。请重试。"
          }
        }
      }
    },
    "The Gateway sent a file this phone can't read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway sent a file this phone can't read."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت البوابة ملفاً لا يستطيع هذا الهاتف قراءته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat eine Datei gesendet, die dieses Telefon nicht lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Gateway envió un archivo que este teléfono no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Gateway a envoyé un fichier que ce téléphone ne peut pas lire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway ने एक ऐसी फ़ाइल भेजी है जिसे यह फ़ोन नहीं पढ़ सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Gateway ha inviato un file che questo telefono non può leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway が、このスマートフォンで読めないファイルを送りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway가 이 휴대폰에서 읽을 수 없는 파일을 보냈습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gateway enviou um arquivo que este telefone não consegue ler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关发送了这部手机无法读取的文件。"
          }
        }
      }
    },
    "This file doesn't match what your Mac has, so it wasn't opened. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file doesn't match what your Mac has, so it wasn't opened. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف لا يطابق ما على جهاز Mac، لذلك لم يُفتح. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei stimmt nicht mit deinem Mac überein und wurde deshalb nicht geöffnet. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no coincide con lo que tiene tu Mac, así que no se abrió. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne correspond pas à celui de votre Mac, il n’a donc pas été ouvert. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल आपके Mac वाली फ़ाइल से मेल नहीं खाती, इसलिए इसे नहीं खोला गया। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non corrisponde a quello del tuo Mac, quindi non è stato aperto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは Mac 上のものと一致しないため、開けませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Mac에 있는 것과 일치하지 않아 열지 않았습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não corresponde ao que está no seu Mac, então não foi aberto. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件与你的 Mac 上的不一致，因此未打开。请重试。"
          }
        }
      }
    },
