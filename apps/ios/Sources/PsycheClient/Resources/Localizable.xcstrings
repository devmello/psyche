    },
    "That pairing link expired or was already used. Make a new link on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing link expired or was already used. Make a new link on your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رابط الاقتران هذا أو سبق استخدامه. أنشئ رابطًا جديدًا على جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungslink ist abgelaufen oder wurde schon benutzt. Erstelle auf deinem Mac einen neuen Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese enlace de emparejamiento caducó o ya se usó. Crea uno nuevo en tu Mac."
