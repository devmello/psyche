{
  "sourceLanguage": "en",
  "strings": {
    "This file changed while it downloaded. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed while it downloaded. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف تغيّر أثناء التنزيل. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat sich während des Downloads geändert. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió mientras se descargaba. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé pendant le téléchargement. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल डाउनलोड होते समय बदल गई। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è cambiato durante il download. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード中にファイルが変更されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하는 동안 파일이 바뀌었습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo mudou durante o download. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在下载期间发生了变化。请重试。"
          }
        }
      }
    },
    "The Gateway sent a file this phone can't read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway sent a file this phone can't read."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت البوابة ملفاً لا يستطيع هذا الهاتف قراءته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat eine Datei gesendet, die dieses Telefon nicht lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Gateway envió un archivo que este teléfono no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Gateway a envoyé un fichier que ce téléphone ne peut pas lire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway ने एक ऐसी फ़ाइल भेजी है जिसे यह फ़ोन नहीं पढ़ सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Gateway ha inviato un file che questo telefono non può leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway が、このスマートフォンで読めないファイルを送りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway가 이 휴대폰에서 읽을 수 없는 파일을 보냈습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gateway enviou um arquivo que este telefone não consegue ler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关发送了这部手机无法读取的文件。"
          }
        }
      }
    },
    "This file doesn't match what your Mac has, so it wasn't opened. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file doesn't match what your Mac has, so it wasn't opened. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف لا يطابق ما على جهاز Mac، لذلك لم يُفتح. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei stimmt nicht mit deinem Mac überein und wurde deshalb nicht geöffnet. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no coincide con lo que tiene tu Mac, así que no se abrió. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne correspond pas à celui de votre Mac, il n’a donc pas été ouvert. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल आपके Mac वाली फ़ाइल से मेल नहीं खाती, इसलिए इसे नहीं खोला गया। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non corrisponde a quello del tuo Mac, quindi non è stato aperto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは Mac 上のものと一致しないため、開けませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Mac에 있는 것과 일치하지 않아 열지 않았습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não corresponde ao que está no seu Mac, então não foi aberto. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件与你的 Mac 上的不一致，因此未打开。请重试。"
          }
        }
      }
    },
    "That file is empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file is empty."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف فارغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo está vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est vide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल खाली है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは空です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 비어 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo está vazio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件为空。"
          }
        }
      }
    },
    "That file is bigger than 25 MB. Add it on your Mac instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file is bigger than 25 MB. Add it on your Mac instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف أكبر من 25 ميغابايت. أضفه على جهاز Mac بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist größer als 25 MB. Füge sie stattdessen auf deinem Mac hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo supera los 25 MB. Añádelo desde tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier fait plus de 25 Mo. Ajoutez-le plutôt depuis votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल 25 MB से बड़ी है। इसे अपने Mac पर जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è più grande di 25 MB. Aggiungilo dal tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは 25 MB を超えています。Mac で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 25MB보다 큽니다. 대신 Mac에서 추가하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo tem mais de 25 MB. Adicione-o no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件超过 25 MB。请改在你的 Mac 上添加。"
          }
        }
      }
    },
    "The Gateway didn't store that file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway didn't store that file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تحفظ البوابة هذا الملف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat die Datei nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Gateway no guardó ese archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Gateway n’a pas enregistré ce fichier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway ने वह फ़ाइल सहेजी नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Gateway non ha salvato quel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway がそのファイルを保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway가 그 파일을 저장하지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gateway não salvou esse arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关未能保存该文件。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
