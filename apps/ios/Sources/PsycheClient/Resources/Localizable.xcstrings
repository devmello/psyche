        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेयरिंग लिंक समाप्त हो गया है या पहले ही इस्तेमाल हो चुका है। अपने Mac पर नया लिंक बनाएँ।"
          }
        },
        "it": {
