    "Try fewer words, or ask Psyche in chat.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try fewer words, or ask Psyche in chat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب كلمات أقل، أو اسأل Psyche في الدردشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
