          "stringUnit": {
            "state": "translated",
            "value": "コマンドの実行後、{name} の {folder} を最後まで確認できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 실행 후 {name}의 {folder}을(를) 끝까지 확인하지 못했습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível terminar de verificar {folder} em {name} após um comando"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令运行后，未能完成检查 {name} 上的 {folder}"
          }
        }
      }
    },
    "notice.machine.scanIncomplete.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما لم تُنقل المستودعات أو ملفات التشغيل الجديدة هناك جانباً. افحصه بحثاً عن مجلدات .git أو .vscode جديدة قبل فتحه في محرر أو تشغيل git فيه. لن تتمكن الأوامر من الكتابة هناك مرة أخرى حتى يُعاد تشغيل Psyche على {name}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Repositorys oder Startdateien dort wurden womöglich nicht beiseitegelegt. Prüfe den Ordner auf neue .git- oder .vscode-Ordner, bevor du ihn in einem Editor öffnest oder dort git ausführst. Befehle können dort erst wieder schreiben, wenn Psyche auf {name} neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New repositories or launch files there may not have been moved aside. Check it for new .git or .vscode folders before you open it in an editor or run git there. Commands can't write there again until Psyche restarts on {name}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que los repositorios o archivos de inicio nuevos que haya ahí no se hayan apartado. Revisa si hay carpetas .git o .vscode nuevas antes de abrirla en un editor o ejecutar git ahí. Los comandos no podrán volver a escribir ahí hasta que Psyche se reinicie en {name}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux dépôts ou fichiers de lancement qui s'y trouvent n'ont peut-être pas été mis de côté. Vérifiez s'il contient de nouveaux dossiers .git ou .vscode avant de l'ouvrir dans un éditeur ou d'y lancer git. Les commandes ne pourront plus y écrire tant que Psyche n'aura pas redémarré sur {name}."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वहाँ के नए रिपॉज़िटरी या लॉन्च फ़ाइलें शायद अलग नहीं की गईं। इसे किसी एडिटर में खोलने या वहाँ git चलाने से पहले नए .git या .vscode फ़ोल्डर देख लें। जब तक {name} पर Psyche दोबारा शुरू नहीं होता, कमांड वहाँ फिर से नहीं लिख सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi repository o file di avvio presenti potrebbero non essere stati messi da parte. Controlla se ci sono nuove cartelle .git o .vscode prima di aprirla in un editor o eseguirci git. I comandi non potranno scriverci di nuovo finché Psyche non si riavvia su {name}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにある新しいリポジトリや起動用ファイルは、退避されていない可能性があります。エディタで開いたり git を実行したりする前に、新しい .git や .vscode フォルダがないか確認してください。{name} で Psyche が再起動するまで、コマンドはそこに書き込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳의 새 저장소나 실행 파일이 따로 옮겨지지 않았을 수 있습니다. 편집기로 열거나 git을 실행하기 전에 새 .git 또는 .vscode 폴더가 있는지 확인하세요. {name}에서 Psyche가 다시 시작될 때까지 명령은 그곳에 쓸 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositórios ou arquivos de inicialização novos ali podem não ter sido colocados de lado. Procure pastas .git ou .vscode novas antes de abri-la em um editor ou rodar git ali. Os comandos só poderão gravar ali de novo quando o Psyche reiniciar em {name}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那里新出现的仓库或启动文件可能没有被移到一旁。在用编辑器打开它或在那里运行 git 之前，请检查是否有新的 .git 或 .vscode 文件夹。在 {name} 上的 Psyche 重启之前，命令无法再写入那里。"
          }
        }
      }
    },
    "notice.machine.offline.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع اتصال {name}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} ist offline gegangen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} went offline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} se desconectó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} est passé hors ligne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} ऑफ़लाइन हो गया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} è andato offline"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}がオフラインになりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}이(가) 오프라인이 되었습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} ficou offline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} 已离线"
          }
        }
      }
    },
    "notice.machine.offline.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Psyche استخدامه حتى يعاود الاتصال. المهام التي تحتاج إليه تنتظرك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche kann es nicht nutzen, bis es sich wieder verbindet. Aufgaben, die es brauchen, warten auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche can't use it until it reconnects. Tasks that need it wait for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche no puede usarlo hasta que se reconecte. Las tareas que lo necesitan esperan por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ne peut pas l'utiliser avant sa reconnexion. Les tâches qui en ont besoin t'attendent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा कनेक्ट होने तक Psyche इसे इस्तेमाल नहीं कर सकता। जिन टास्क को इसकी ज़रूरत है, वे आपका इंतज़ार करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche non può usarlo finché non si riconnette. Le attività che ne hanno bisogno aspettano te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続するまでPsycheは使えません。必要とするタスクは、あなたを待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결될 때까지 Psyche가 사용할 수 없습니다. 필요한 작업은 사용자를 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche não pode usá-lo até que ele se reconecte. As tarefas que precisam dele esperam por você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接前 Psyche 无法使用它。需要它的任务会等你处理。"
          }
        }
      }
    },
    "notice.approvals.digest.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الموافقات للموافقة عليها أو رفضها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Genehmigungen, um sie zu genehmigen oder abzulehnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Approvals to approve or decline them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Aprobaciones para aprobarlas o rechazarlas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Approbations pour les approuver ou les refuser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें मंज़ूर या अस्वीकार करने के लिए मंज़ूरियाँ खोलें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Approvazioni per approvarle o rifiutarle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を開いて、承認または拒否してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 열어 승인하거나 거절하세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Aprovações para aprová-las ou recusá-las"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“审批”来批准或拒绝它们"
          }
        }
      }
    },
    "notice.attention.paused.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمة تنتظرك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe wartet auf dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task is waiting for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea te está esperando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche vous attend"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टास्क आपका इंतज़ार कर रहा है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività ti aspetta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクがあなたを待っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 기다리고 있습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa está esperando por você"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任务在等你"
          }
        }
      }
    },
    "notice.attention.paused.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت مؤقتًا قبل {tool} على تطبيق أو موقع حساس إلى أن تعود إلى Psyche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor {tool} auf einer sensiblen App oder Website pausiert, bis du wieder in Psyche bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused before {tool} on a sensitive app or site until you are back in Psyche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa antes de {tool} en una app o sitio sensible hasta que vuelvas a Psyche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause avant {tool} sur une app ou un site sensible, jusqu’à votre retour dans Psyche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी संवेदनशील ऐप या साइट पर {tool} से पहले रोक दिया गया, जब तक आप Psyche में वापस नहीं आते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa prima di {tool} su un’app o un sito sensibile, finché non torni in Psyche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密性の高いアプリやサイトで {tool} の前に一時停止しています。Psyche に戻るまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 앱이나 사이트에서 {tool} 직전에 멈췄습니다. Psyche로 돌아올 때까지 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa antes de {tool} em um app ou site sensível, até você voltar ao Psyche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在敏感的应用或网站上，已在 {tool} 之前暂停，等你回到 Psyche。"
          }
        }
      }
    },
    "notice.browser.chrome.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche يتحكم في Chrome لديك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche steuert dein Chrome"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche is driving your Chrome"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche está controlando tu Chrome"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche pilote votre Chrome"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche आपका Chrome चला रहा है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche sta usando il tuo Chrome"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche があなたの Chrome を操作しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 Chrome을 조작하고 있습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche está controlando seu Chrome"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 正在操作你的 Chrome"
          }
        }
      }
    },
    "notice.browser.chrome.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم مهمة ملف Chrome الخاص بـ Psyche الذي سجّلت الدخول فيه. عنوان نافذته “Psyche is driving this window”. يُغلق عند انتهاء المهمة، ويمكنك أيضًا إنهاء Chrome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe nutzt das Psyche-Chrome-Profil, in dem du angemeldet bist. Der Fenstertitel lautet „Psyche is driving this window“. Es schließt sich, wenn die Aufgabe fertig ist; du kannst Chrome auch beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task is using the Psyche Chrome profile, where you are signed in. Its window title says “Psyche is driving this window”. It closes when the task is done; you can also quit Chrome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea usa el perfil de Chrome de Psyche, donde tienes la sesión iniciada. El título de su ventana dice “Psyche is driving this window”. Se cierra cuando termina la tarea; también puedes salir de Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche utilise le profil Chrome de Psyche, où vous êtes connecté. Le titre de sa fenêtre indique « Psyche is driving this window ». Elle se ferme à la fin de la tâche ; vous pouvez aussi quitter Chrome."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टास्क Psyche के Chrome प्रोफ़ाइल का उपयोग कर रहा है, जिसमें आप साइन इन हैं। उसकी विंडो के शीर्षक में “Psyche is driving this window” लिखा है। टास्क पूरा होने पर वह बंद हो जाता है; आप Chrome को खुद भी बंद कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività usa il profilo Chrome di Psyche, dove hai effettuato l’accesso. Il titolo della finestra dice “Psyche is driving this window”. Si chiude al termine dell’attività; puoi anche chiudere Chrome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが、サインイン済みの Psyche 用 Chrome プロファイルを使っています。ウィンドウのタイトルは「Psyche is driving this window」です。タスクが終わると閉じます。Chrome を終了することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 로그인되어 있는 Psyche용 Chrome 프로필을 사용하고 있습니다. 창 제목은 “Psyche is driving this window”입니다. 작업이 끝나면 닫히며, Chrome을 직접 종료해도 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa está usando o perfil do Chrome do Psyche, onde você está conectado. O título da janela diz “Psyche is driving this window”. Ela fecha quando a tarefa termina; você também pode sair do Chrome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任务正在使用你已登录的 Psyche Chrome 配置文件。窗口标题为“Psyche is driving this window”。任务完成后会关闭，你也可以退出 Chrome。"
          }
        }
      }
    },
    "notice.browser.takeover.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاجك Psyche في المتصفح"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche braucht dich im Browser"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche needs you in the browser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche te necesita en el navegador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche a besoin de vous dans le navigateur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche को ब्राउज़र में आपकी ज़रूरत है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ha bisogno di te nel browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで Psyche の手助けが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 Psyche가 도움을 필요로 합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche precisa de você no navegador"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 需要你在浏览器中协助"
          }
        }
      }
    },
    "notice.browser.takeover.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على {host}، يسأل الوكيل: {reason}. تولَّ التحكم في لوحة المتصفح ثم أعده إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf {host} fragt der Agent: {reason}. Übernimm im Browserbereich die Steuerung und gib sie dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On {host}, the agent asks: {reason}. Take control in the browser pane, then hand it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En {host}, el agente pregunta: {reason}. Toma el control en el panel del navegador y luego devuélvelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur {host}, l’agent demande : {reason}. Prenez la main dans le volet du navigateur, puis rendez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} पर एजेंट पूछ रहा है: {reason}। ब्राउज़र पेन में नियंत्रण अपने हाथ में लें, फिर उसे वापस सौंप दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su {host}, l’agente chiede: {reason}. Prendi il controllo nel pannello del browser, poi restituiscilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} でエージェントが尋ねています: {reason}。ブラウザのペインで操作を引き継ぎ、終わったら戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}에서 에이전트가 묻습니다: {reason}. 브라우저 창에서 직접 조작한 뒤 다시 넘겨주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em {host}, o agente pergunta: {reason}. Assuma o controle no painel do navegador e depois devolva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 {host} 上，智能体询问：{reason}。请在浏览器窗格中接管操作，完成后再交还。"
          }
        }
      }
    },
    "notice.connector.changed.title": {
      "extractionState": "manual",
