    "Psyche will ask again the next time it needs this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche will ask again the next time it needs this."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيسأل Psyche مرة أخرى في المرة القادمة التي يحتاج فيها إلى هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche fragt beim nächsten Mal wieder nach, wenn es dies braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche volverá a preguntar la próxima vez que lo necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche redemandera la prochaine fois qu’il en aura besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार जब Psyche को इसकी ज़रूरत होगी, वह फिर पूछेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche chiederà di nuovo la prossima volta che ne avrà bisogno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に必要になったとき、Psycheはもう一度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 필요할 때 Psyche가 다시 물어봅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche perguntará de novo na próxima vez que precisar disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次需要时，Psyche 会再次询问。"
          }
        }
      }
    },
