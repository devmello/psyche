    "This one is not a person or project. The phone shows people and projects; open it on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس شخصًا أو مشروعًا. يعرض الهاتف الأشخاص والمشاريع؛ افتحه على جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist weder eine Person noch ein Projekt. Das Telefon zeigt Personen und Projekte; öffne es auf deinem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one is not a person or project. The phone shows people and projects; open it on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una persona ni un proyecto. El teléfono muestra personas y proyectos; ábrelo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est ni une personne ni un projet. Le téléphone affiche les personnes et les projets ; ouvrez-le sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोई व्यक्ति या प्रोजेक्ट नहीं है। फ़ोन पर लोग और प्रोजेक्ट दिखते हैं; इसे अपने Mac पर खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non è una persona né un progetto. Il telefono mostra persone e progetti; aprilo sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは人物やプロジェクトではありません。電話では人物とプロジェクトを表示します。Macで開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 사람이나 프로젝트가 아닙니다. 휴대폰은 사람과 프로젝트를 보여 줍니다. Mac에서 여세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item não é uma pessoa nem um projeto. O celular mostra pessoas e projetos; abra-o no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是人物或项目。手机只显示人物和项目；请在 Mac 上打开。"
          }
        }
      }
    },
