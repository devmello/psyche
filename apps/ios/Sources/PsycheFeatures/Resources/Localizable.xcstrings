    "This one isn't kept on your phone. It lives in your Library on your Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one isn't kept on your phone. It lives in your Library on your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا غير محفوظ على هاتفك. يوجد في مكتبتك على جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wird nicht auf deinem iPhone gespeichert. Es liegt in deiner Bibliothek auf dem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se guarda en tu teléfono. Está en tu biblioteca del Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n'est pas conservé sur ton téléphone. Il se trouve dans ta bibliothèque sur ton Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके फ़ोन पर नहीं रखा जाता। यह आपके Mac की लाइब्रेरी में रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non è conservato sul telefono. Si trova nella tua libreria sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは iPhone には保存されていません。Mac のライブラリにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 휴대폰에 보관되지 않습니다. Mac의 보관함에 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não fica guardado no telefone. Ele está na sua Biblioteca no Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个内容不保存在你的手机上，而是在你 Mac 的资料库中。"
          }
        }
      }
    },
    "This one isn't opened on your phone. Read it in Psyche on your Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
