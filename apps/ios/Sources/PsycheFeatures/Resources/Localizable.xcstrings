    "Cancelled. Nothing will change.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. Nothing will change."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
