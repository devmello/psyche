    "Your Mac shows the same security code next to this phone's request. If they differ, don't connect.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جهاز Mac رمز الأمان نفسه بجوار طلب هذا الهاتف. إذا اختلفا فلا تتصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac zeigt denselben Sicherheitscode neben der Anfrage dieses iPhones. Wenn sie sich unterscheiden, verbinde dich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac shows the same security code next to this phone's request. If they differ, don't connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac muestra el mismo código de seguridad junto a la solicitud de este teléfono. Si no coinciden, no te conectes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Mac affiche le même code de sécurité à côté de la demande de ce téléphone. S’ils diffèrent, ne te connecte pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac इस फ़ोन के अनुरोध के पास वही सुरक्षा कोड दिखाता है। अगर वे अलग हों, तो कनेक्ट न करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac mostra lo stesso codice di sicurezza accanto alla richiesta di questo telefono. Se sono diversi, non collegarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac には、この iPhone のリクエストの横に同じセキュリティコードが表示されます。違う場合は接続しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에는 이 iPhone의 요청 옆에 같은 보안 코드가 표시됩니다. 다르면 연결하지 마세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac mostra o mesmo código de segurança ao lado da solicitação deste iPhone. Se forem diferentes, não conecte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 会在此 iPhone 的请求旁显示相同的安全码。如果不一致，请不要连接。"
          }
        }
      }
    },
