            "value": "أوقف Psyche الاتصال ولم يرسل شيئًا. إذا أعدت ضبط جهاز Mac، فأعد الإقران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche hat angehalten und nichts gesendet. Wenn du deinen Mac zurückgesetzt hast, koppele erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche se detuvo y no envió nada. Si restableciste tu Mac, vuelve a vincular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche s’est arrêté et n’a rien envoyé. Si vous avez réinitialisé votre Mac, associez-le à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche रुक गया और कुछ नहीं भेजा। यदि आपने अपना Mac रीसेट किया है, तो फिर से जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche si è fermato e non ha inviato nulla. Se hai ripristinato il Mac, associa di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche は停止し、何も送信しませんでした。Mac をリセットした場合は、もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 멈췄고 아무것도 보내지 않았습니다. Mac을 초기화했다면 다시 페어링하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche parou e não enviou nada. Se você redefiniu o Mac, pareie novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 已停止,没有发送任何内容。如果你重置过 Mac,请重新配对。"
          }
        }
      }
    },
    "Psyche sent nothing and keeps trying. If you reset your Mac, pair again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche sent nothing and keeps trying. If you reset your Mac, pair again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرسل Psyche شيئًا ويواصل المحاولة. إذا أعدت ضبط جهاز Mac، فأعد الإقران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche hat nichts gesendet und versucht es weiter. Wenn du deinen Mac zurückgesetzt hast, koppele erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche no envió nada y sigue intentándolo. Si restableciste tu Mac, vuelve a vincular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche n’a rien envoyé et continue d’essayer. Si vous avez réinitialisé votre Mac, associez-le à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ने कुछ नहीं भेजा और कोशिश करता रहेगा। यदि आपने अपना Mac रीसेट किया है, तो फिर से जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche non ha inviato nulla e continua a provare. Se hai ripristinato il Mac, associa di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche は何も送信せず、再試行を続けます。Mac をリセットした場合は、もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 아무것도 보내지 않았고 계속 시도합니다. Mac을 초기화했다면 다시 페어링하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche não enviou nada e continua tentando. Se você redefiniu o Mac, pareie novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 没有发送任何内容,并会继续尝试。如果你重置过 Mac,请重新配对。"
          }
        }
      }
    },
