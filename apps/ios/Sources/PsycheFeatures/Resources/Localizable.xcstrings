    "Files Psyche fetches from the web for a task are kept here.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files Psyche fetches from the web for a task are kept here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ هنا الملفات التي يجلبها Psyche من الويب لمهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die Psyche für eine Aufgabe aus dem Web abruft, werden hier gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se guardan los archivos que Psyche descarga de la web para una tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que Psyche récupère sur le web pour une tâche sont conservés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कार्य के लिए Psyche जो फ़ाइलें वेब से लाता है, वे यहाँ रखी जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file che Psyche scarica dal web per un'attività sono conservati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクのために Psyche が Web から取得したファイルはここに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 작업을 위해 웹에서 가져온 파일은 여기에 보관됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos que o Psyche busca na web para uma tarefa ficam guardados aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 为任务从网络获取的文件会保存在这里。"
          }
        }
      }
    },
