    "Live Activities are off for Psyche in the iOS Settings app.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are off for Psyche in the iOS Settings app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأنشطة المباشرة متوقفة لـ Psyche في تطبيق إعدادات iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind für Psyche in der App „Einstellungen“ von iOS aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actividades en directo están desactivadas para Psyche en la app Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées pour Psyche dans l'app Réglages d'iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स ऐप में Psyche के लिए लाइव गतिविधियाँ बंद हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività dal vivo sono disattivate per Psyche nell'app Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の「設定」アプリで Psyche のライブアクティビティがオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 앱에서 Psyche의 실시간 활동이 꺼져 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As atividades ao vivo estão desativadas para o Psyche no app Ajustes do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 的实时活动已在 iOS“设置”应用中关闭。"
          }
        }
      }
    },
    "Live Activities are off for Psyche in the iOS Settings app. Turn them on there to see tasks on the Lock Screen.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are off for Psyche in the iOS Settings app. Turn them on there to see tasks on the Lock Screen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأنشطة المباشرة متوقفة لـ Psyche في تطبيق إعدادات iOS. فعّلها هناك لرؤية المهام على شاشة القفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind für Psyche in der App „Einstellungen“ aus. Aktiviere sie dort, um Aufgaben auf dem Sperrbildschirm zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actividades en directo están desactivadas para Psyche en Ajustes de iOS. Actívalas para ver tareas en la pantalla de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées pour Psyche dans Réglages d'iOS. Active-les pour voir les tâches sur l'écran verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स में Psyche के लिए लाइव गतिविधियाँ बंद हैं। लॉक स्क्रीन पर कार्य देखने के लिए उन्हें चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività dal vivo sono disattivate per Psyche nelle Impostazioni di iOS. Attivale per vedere le attività nella schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の「設定」で Psyche のライブアクティビティがオフです。ロック画面でタスクを見るにはオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 Psyche의 실시간 활동이 꺼져 있습니다. 잠금 화면에서 작업을 보려면 켜세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As atividades ao vivo estão desativadas para o Psyche nos Ajustes do iOS. Ative-as para ver tarefas na tela de bloqueio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 的实时活动已在 iOS“设置”中关闭。请开启后即可在锁定屏幕上查看任务。"
          }
        }
      }
    },
