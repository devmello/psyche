    "Open Settings → Server & remote access → Pair another computer on your Mac, then scan the code it shows.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → Server & remote access → Pair another computer on your Mac, then scan the code it shows."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح على جهاز Mac: الإعدادات ← الخادم والوصول عن بُعد ← اقتران جهاز آخر، ثم امسح الرمز الذي يظهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf deinem Mac Einstellungen → Server und Fernzugriff → Anderen Computer koppeln und scanne dann den angezeigten Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre en tu Mac Ajustes → Servidor y acceso remoto → Emparejar otro ordenador y escanea el código que muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre sur ton Mac Réglages → Serveur et accès à distance → Associer un autre ordinateur, puis scanne le code affiché."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर सेटिंग्स → Server & remote access → Pair another computer खोलें, फिर दिखाया गया कोड स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul Mac apri Impostazioni → Server e accesso remoto → Abbina un altro computer, poi scansiona il codice mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で「設定」→「サーバーとリモートアクセス」→「別のコンピュータとペアリング」を開き、表示されたコードを読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 설정 → 서버 및 원격 액세스 → 다른 컴퓨터 페어링을 열고 표시된 코드를 스캔하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac, abra Ajustes → Servidor e acesso remoto → Parear outro computador e escaneie o código exibido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开“设置”→“服务器与远程访问”→“与另一台电脑配对”，然后扫描它显示的代码。"
          }
        }
      }
    },
