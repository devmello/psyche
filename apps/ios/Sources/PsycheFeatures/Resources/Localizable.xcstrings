    "Nothing else from them will be remembered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else from them will be remembered."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُتذكر أي شيء آخر منهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Weiteres von ihnen wird gemerkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recordará nada más de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'autre venant d'eux ne sera retenu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनकी कोई और बात याद नहीं रखी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nient'altro da loro verrà ricordato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この送信者からの他の内容は記憶されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 발신자의 다른 내용은 기억되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais deles será lembrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此后不会再记住他们的其他内容。"
          }
        }
      }
    },
