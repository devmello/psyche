    "It may be asleep. Answers wait until it's back.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may be asleep. Answers wait until it's back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما يكون في وضع السكون. تنتظر الردود حتى يعود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er schläft vielleicht. Antworten warten, bis er wieder da ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede estar dormido. Las respuestas esperan a que vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être en veille. Les réponses attendent son retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सो रहा हो सकता है। वापस आने तक जवाब रुके रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere in stand-by. Le risposte attendono che torni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ中の可能性があります。戻るまで回答は待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절전 상태일 수 있습니다. 돌아올 때까지 답변을 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode estar em suspensão. As respostas aguardam até ele voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能处于休眠状态。在它恢复前，回答会等待。"
          }
        }
      }
    },
