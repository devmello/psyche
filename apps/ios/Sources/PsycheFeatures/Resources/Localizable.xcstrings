    "On your Mac, approve %@. It gets read, write and approvals, not admin.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, approve %@. It gets read, write and approvals, not admin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز Mac، وافق على %@. يحصل على القراءة والكتابة والموافقات، دون صلاحيات المسؤول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib auf deinem Mac %@ frei. Es erhält Lese- und Schreibzugriff sowie Freigaben, aber keine Admin-Rechte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, aprueba a %@. Recibe lectura, escritura y aprobaciones, no administración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ton Mac, approuve %@. Il obtient lecture, écriture et approbations, pas les droits d'administration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर %@ को स्वीकृति दें। इसे पढ़ने, लिखने और स्वीकृतियों की अनुमति मिलती है, एडमिन की नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul Mac approva %@. Ottiene lettura, scrittura e approvazioni, non amministrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で %@ を承認してください。読み取り、書き込み、承認はできますが、管理権限はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 %@을(를) 승인하세요. 읽기, 쓰기, 승인 권한만 받으며 관리 권한은 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu Mac, aprove %@. Ele recebe leitura, escrita e aprovações, não administração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上批准 %@。它获得读取、写入和审批权限，但没有管理员权限。"
          }
        }
      }
    },
