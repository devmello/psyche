    "Kept out of memory, and senders you trust": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept out of memory, and senders you trust"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستبعد من الذاكرة، والمرسلون الذين تثق بهم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ins Gedächtnis übernommen, und vertrauenswürdige Absender"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de la memoria, y remitentes de confianza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écartés de la mémoire, et expéditeurs de confiance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मृति से बाहर रखा गया, और भरोसेमंद प्रेषक"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esclusi dalla memoria, e mittenti attendibili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリから除外した内容と、信頼する送信者"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리에서 제외된 내용과 신뢰하는 발신자"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora da memória, e remetentes de confiança"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除在记忆之外的内容，以及你信任的发件人"
          }
        }
      }
    },
    "Text Psyche kept out of memory. Nothing is remembered from it until you release it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text Psyche kept out of memory. Nothing is remembered from it until you release it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص احتفظ به Psyche خارج الذاكرة. لا يُتذكر منه شيء حتى تفرج عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, den Psyche nicht ins Gedächtnis übernommen hat. Daraus wird nichts gemerkt, bis du ihn freigibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto que Psyche dejó fuera de la memoria. No se recuerda nada de él hasta que lo liberes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte que Psyche a écarté de la mémoire. Rien n'en est retenu tant que vous ne le libérez pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पाठ जिसे Psyche ने स्मृति से बाहर रखा। आपके जारी करने तक इससे कुछ भी याद नहीं रखा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo che Psyche ha escluso dalla memoria. Non si ricorda nulla da esso finché non lo rilasci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche がメモリから除外したテキストです。解除するまで、ここから何も記憶しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 메모리에서 제외한 텍스트입니다. 풀어주기 전까지는 여기서 아무것도 기억하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto que o Psyche deixou fora da memória. Nada é lembrado dele até que você o libere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 排除在记忆之外的文本。在你放行之前，不会从中记住任何内容。"
          }
        }
      }
    },
