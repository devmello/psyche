    "They become one person, with all their facts and contact details. You can split them again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They become one person, with all their facts and contact details. You can split them again later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبحان شخصاً واحداً، مع كل معلوماتهما وبيانات التواصل. يمكنك فصلهما لاحقاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden eine Person mit allen Fakten und Kontaktdaten. Du kannst sie später wieder aufteilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Serán una sola persona, con todos sus datos y contactos. Puedes separarlas más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles deviendront une seule personne, avec tous leurs faits et coordonnées. Vous pourrez les séparer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये एक व्यक्ति बन जाएँगे, इनकी सभी जानकारी और संपर्क विवरण के साथ। बाद में फिर से अलग कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventeranno una sola persona, con tutti i loro fatti e recapiti. Potrai separarle di nuovo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての情報と連絡先がまとまり、ひとりになります。後から分割することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 정보와 연락처가 한 사람으로 합쳐집니다. 나중에 다시 나눌 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vão virar uma só pessoa, com todos os fatos e contatos. Você pode separá-las depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两人将合并为一人，保留全部事实和联系方式。之后仍可拆分。"
          }
        }
      }
    },
