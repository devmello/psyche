    "Camera access is off. Turn it on in Settings to scan the code.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. Turn it on in Settings to scan the code."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا متوقف. فعّله في الإعدادات لمسح الرمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff ist aus. Aktiviere ihn in den Einstellungen, um den Code zu scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado. Actívalo en Ajustes para escanear el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est désactivé. Active-le dans Réglages pour scanner le code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा एक्सेस बंद है। कोड स्कैन करने के लिए इसे सेटिंग्स में चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato. Attivalo in Impostazioni per scansionare il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフです。コードを読み取るには設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 꺼져 있습니다. 코드를 스캔하려면 설정에서 켜세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado. Ative-o em Ajustes para escanear o código."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限已关闭。请在“设置”中开启以扫描代码。"
          }
        }
      }
    },
    "Change everything else on your Mac, in Settings.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
