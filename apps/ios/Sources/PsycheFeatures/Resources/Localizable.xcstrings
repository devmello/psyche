    "It won't run again, and this can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It won't run again, and this can't be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تعمل مرة أخرى، ولا يمكن التراجع عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie läuft nicht mehr, und das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volverá a ejecutarse y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne s'exécutera plus, et ce n'est pas réversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फिर नहीं चलेगा, और इसे वापस नहीं लाया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non verrà più eseguita e l'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後実行されず、この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 실행되지 않으며, 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não voltará a executar, e isto não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将不再运行，且此操作无法撤销。"
          }
        }
      }
    },
    "This runs on an event or a watch, so edit it on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs on an event or a watch, so edit it on your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل هذه الأتمتة عند حدث أو مراقبة، لذا عدّلها من جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das läuft bei einem Ereignis oder einer Überwachung, daher bearbeite es auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se ejecuta con un evento o una vigilancia, así que edítalo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se déclenche sur un événement ou une surveillance : modifiez-la sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किसी घटना या निगरानी पर चलता है, इसलिए इसे अपने Mac पर संपादित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eseguita da un evento o da un controllo, quindi modificala sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントまたは監視で実行されるため、Mac で編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트나 감시로 실행되므로 Mac에서 편집하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é executado por um evento ou uma vigilância, por isso edite-o no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它由事件或监视触发，请在 Mac 上编辑。"
          }
        }
      }
    },
