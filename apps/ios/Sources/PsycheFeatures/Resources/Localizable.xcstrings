    "The notes and files your agent keeps. Read-only on the phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملاحظات والملفات التي يحتفظ بها وكيلك. للقراءة فقط على الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notizen und Dateien, die dein Agent führt. Auf dem Telefon nur lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notes and files your agent keeps. Read-only on the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas y archivos que guarda tu agente. Solo lectura en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes et fichiers que conserve votre agent. Lecture seule sur le téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके एजेंट द्वारा रखी गई नोट्स और फ़ाइलें। फ़ोन पर केवल पढ़ने के लिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note e i file che il tuo agente conserva. Solo lettura sul telefono."
          }
        },
