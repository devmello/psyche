    "That is as far as one answer goes. Ask Psyche in chat to keep going.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is as far as one answer goes. Ask Psyche in chat to keep going."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو أقصى ما تقدّمه إجابة واحدة. اسأل Psyche في الدردشة لمتابعة الحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr passt in eine Antwort nicht. Frag Psyche im Chat, um weiterzumachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta aquí llega una respuesta. Pide a Psyche en el chat que siga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule réponse ne va pas plus loin. Demande à Psyche dans la discussion de continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उत्तर इतना ही हो सकता है। आगे बढ़ने के लिए चैट में Psyche से पूछें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta non può andare oltre. Chiedi a Psyche in chat di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回の回答はここまでです。続けるにはチャットで Psyche に聞いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 답변은 여기까지입니다. 계속하려면 채팅에서 Psyche에게 물어보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma resposta vai até aqui. Peça ao Psyche no chat para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次回答只能到这里。请在聊天中让 Psyche 继续。"
          }
        }
      }
    },
    "That's everything for today.": {
      "extractionState": "extracted_with_value",
