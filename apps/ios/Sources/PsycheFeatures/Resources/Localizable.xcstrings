    "No standing permissions yet. Choosing “Always allow” on an approval adds one here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No standing permissions yet. Choosing “Always allow” on an approval adds one here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أذونات دائمة بعد. عند اختيار «السماح دائمًا» في طلب موافقة تُضاف إلى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine dauerhaften Berechtigungen. Wenn du bei einer Freigabe „Immer erlauben“ wählst, erscheint sie hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay permisos permanentes. Al elegir «Permitir siempre» en una aprobación, se añade uno aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune autorisation permanente pour l’instant. Choisir « Toujours autoriser » sur une approbation en ajoute une ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई स्थायी अनुमति नहीं है। किसी अनुमोदन पर “हमेशा अनुमति दें” चुनने पर यहाँ एक जुड़ जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna autorizzazione permanente. Scegliendo «Consenti sempre» su un’approvazione ne viene aggiunta una qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常時許可はまだありません。承認で「常に許可」を選ぶと、ここに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 상시 권한이 없습니다. 승인에서 ‘항상 허용’을 선택하면 여기에 추가됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há permissões permanentes. Escolher “Sempre permitir” em uma aprovação adiciona uma aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有长期权限。在审批中选择“始终允许”后，会在这里添加一条。"
          }
        }
      }
    },
