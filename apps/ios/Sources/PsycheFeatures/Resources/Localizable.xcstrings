    "notice.connector.reconnect.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد موصّل إمكانية الوصول ويلزمك تسجيل الدخول من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Connector hat den Zugriff verloren. Melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connector lost access and needs you to sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conector perdió el acceso y necesitas iniciar sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un connecteur a perdu l’accès et vous devez vous reconnecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कनेक्टर की पहुँच खत्म हो गई है; आपको फिर से साइन इन करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un connettore ha perso l’accesso e devi accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コネクタがアクセスを失いました。もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커넥터가 접근 권한을 잃었습니다. 다시 로그인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um conector perdeu o acesso e você precisa entrar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个连接器失去了访问权限，需要你重新登录。"
          }
        }
      }
    },
    "notice.security.changed.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع Psyche عن تغيير أمني أُجري خارج التطبيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche hat eine Sicherheitsänderung rückgängig gemacht, die außerhalb der App erfolgte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche undid a security change made outside the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche deshizo un cambio de seguridad hecho fuera de la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche a annulé une modification de sécurité faite en dehors de l’app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ने ऐप के बाहर किया गया सुरक्षा बदलाव पलट दिया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ha annullato una modifica di sicurezza fatta fuori dall’app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの外で行われたセキュリティ変更を Psyche が元に戻しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 밖에서 이루어진 보안 변경을 Psyche가 되돌렸습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche desfez uma alteração de segurança feita fora do app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 撤销了在应用之外进行的安全更改"
          }
        }
      }
    },
    "notice.security.firstAdmin.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشأ أمر على هذا الـ Mac أول جهاز مسؤول"
