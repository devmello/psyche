    "This deletes the chat and its messages. Receipts and audit entries are kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the chat and its messages. Receipts and audit entries are kept."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف هذه المحادثة ورسائلها. ستبقى الإيصالات وسجلات التدقيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden der Chat und seine Nachrichten gelöscht. Belege und Prüfprotokolle bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el chat y sus mensajes. Los recibos y los registros de auditoría se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la conversation et ses messages. Les reçus et les entrées d'audit sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे चैट और उसके संदेश हटेंगे। रसीदें और ऑडिट प्रविष्टियाँ रखी जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina la chat e i suoi messaggi. Ricevute e voci di controllo vengono conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットとそのメッセージを削除します。レシートと監査記録は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅과 메시지가 삭제됩니다. 영수증과 감사 기록은 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina a conversa e as suas mensagens. Os recibos e os registos de auditoria são mantidos."
