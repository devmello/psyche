    "Notifications are off for Psyche in the iOS Settings app. Turn them on there, then try again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off for Psyche in the iOS Settings app. Turn them on there, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة لـ Psyche في تطبيق إعدادات iOS. فعّلها هناك ثم حاول مجدداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
