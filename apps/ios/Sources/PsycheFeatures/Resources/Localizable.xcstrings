    "Open Psyche to answer this one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Psyche للرد على هذا الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Psyche, um das zu beantworten."
          }
        },
        "en": {
