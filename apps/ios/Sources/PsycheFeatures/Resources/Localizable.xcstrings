    "You're looking at sample content. Exit to go back to pairing with your Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're looking at sample content. Exit to go back to pairing with your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تراه محتوى تجريبي. اخرج للعودة إلى الاقتران مع جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst Beispielinhalte. Beende die Demo, um dich wieder mit deinem Mac zu koppeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo contenido de ejemplo. Sal para volver a emparejar con tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vois du contenu d’exemple. Quitte la démo pour revenir à l’association avec ton Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप नमूना सामग्री देख रहे हैं। अपने Mac से पेयर करने के लिए वापस जाने हेतु बाहर निकलें।"
          }
        },
        "it": {
