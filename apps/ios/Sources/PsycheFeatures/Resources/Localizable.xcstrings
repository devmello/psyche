    "Lessons from your corrections. Keep one, change its wording, or forget it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lessons from your corrections. Keep one, change its wording, or forget it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دروس من تصحيحاتك. احتفظ بأحدها، أو غيّر صياغته، أو انسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektionen aus deinen Korrekturen. Behalte eine, ändere den Wortlaut oder vergiss sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecciones de tus correcciones. Guarda una, cambia su redacción o olvídala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leçons tirées de vos corrections. Gardez-en une, changez sa formulation ou oubliez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सुधारों की सीख। किसी को रखें, उसका शब्द बदलें, या भूल जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezioni dalle tue correzioni. Tienine una, cambia la formulazione o dimenticala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの訂正からの学び。残す、言い回しを変える、忘れるを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정에서 얻은 교훈입니다. 유지하거나, 문구를 바꾸거나, 잊을 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lições das suas correções. Mantenha uma, mude a redação ou esqueça."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你更正的经验。可保留、修改措辞或忘记。"
          }
        }
      }
    },
