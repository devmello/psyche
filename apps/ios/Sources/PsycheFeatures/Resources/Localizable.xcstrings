    "An item from your Messages. Open on your Mac to apply.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنصر من رسائلك. افتحه على جهاز Mac لتطبيقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag aus deinen Nachrichten. Öffne ihn auf deinem Mac, um ihn anzuwenden."
          }
        },
        "en": {
