    "This can take actions for you. Anything that needs your approval still waits for you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتخذ هذه الأداة إجراءات نيابةً عنك. أي شيء يحتاج إلى موافقتك ينتظر حتى توافق عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann in deinem Namen Aktionen ausführen. Was deine Freigabe braucht, wartet weiter auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take actions for you. Anything that needs your approval still waits for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede hacer acciones por ti. Lo que necesite tu aprobación seguirá esperando a que lo apruebes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut agir à ta place. Ce qui demande ton accord attend toujours ta validation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी ओर से कार्रवाई कर सकता है। जिसे आपकी मंज़ूरी चाहिए, वह आपके जवाब का इंतज़ार करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può compiere azioni per te. Ciò che richiede la tua approvazione resta in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに操作を行うことがあります。承認が必要なものは、承認されるまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 작업을 수행할 수 있습니다. 승인이 필요한 항목은 승인할 때까지 대기합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode agir por você. O que precisar da sua aprovação continua esperando por você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能会替你执行操作。需要你批准的内容会继续等待你批准。"
          }
        }
      }
    },
