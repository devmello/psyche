    "Your Mac forgets this phone and this phone clears everything it saved. You'll pair again to use Psyche here.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac forgets this phone and this phone clears everything it saved. You'll pair again to use Psyche here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاهل جهاز Mac هذا الهاتف ويمسح الهاتف كل ما حفظه. ستقترن مرة أخرى لاستخدام Psyche هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac vergisst dieses iPhone, und das iPhone löscht alles, was es gespeichert hat. Du musst dich erneut koppeln, um Psyche hier zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac olvida este teléfono y el teléfono borra todo lo que guardó. Tendrás que volver a emparejarlo para usar Psyche aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Mac oublie ce téléphone et le téléphone efface tout ce qu'il a enregistré. Tu devras l'associer à nouveau pour utiliser Psyche ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac इस फ़ोन को भूल जाएगा और फ़ोन वह सब मिटा देगा जो उसने सहेजा है। Psyche यहाँ इस्तेमाल करने के लिए फिर से पेयर करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac dimentica questo telefono e il telefono cancella tutto ciò che ha salvato. Dovrai riabbinarlo per usare Psyche qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac はこの iPhone を忘れ、iPhone は保存していた内容をすべて消去します。ここで Psyche を使うには再度ペアリングが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 이 휴대폰을 잊고, 휴대폰은 저장된 모든 내용을 지웁니다. 여기서 Psyche를 쓰려면 다시 페어링해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac esquece este telefone e o telefone apaga tudo o que salvou. Você precisará parear novamente para usar o Psyche aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 将忘记此手机，手机也会清除其保存的全部内容。要在此使用 Psyche 需要重新配对。"
          }
        }
      }
    },
    "Your Mac shows the same key next to this phone's request. If they differ, don't connect.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac shows the same key next to this phone's request. If they differ, don't connect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جهاز Mac المفتاح نفسه بجانب طلب هذا الهاتف. إن اختلفا فلا تتصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac zeigt denselben Schlüssel neben der Anfrage dieses iPhones. Wenn sie abweichen, verbinde dich nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac muestra la misma clave junto a la solicitud de este teléfono. Si difieren, no te conectes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Mac affiche la même clé à côté de la demande de ce téléphone. S'ils diffèrent, ne te connecte pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac इस फ़ोन के अनुरोध के साथ वही कुंजी दिखाता है। अगर वे अलग हैं, तो कनेक्ट न करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac mostra la stessa chiave accanto alla richiesta di questo telefono. Se sono diverse, non connetterti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac にはこの iPhone の要求と同じキーが表示されます。異なる場合は接続しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 이 휴대폰 요청과 같은 키가 표시됩니다. 다르면 연결하지 마세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac mostra a mesma chave ao lado do pedido deste telefone. Se forem diferentes, não conecte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 会在此手机请求旁显示相同的密钥。如果不一致，请不要连接。"
          }
        }
      }
    },
