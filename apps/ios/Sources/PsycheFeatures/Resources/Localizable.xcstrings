      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't available for your language on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإملاء غير متاح للغة لديك على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren ist für deine Sprache auf diesem Gerät nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado no está disponible para tu idioma en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n'est pas disponible pour ta langue sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर आपकी भाषा के लिए डिक्टेशन उपलब्ध नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non è disponibile per la tua lingua su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではお使いの言語の音声入力は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 사용 중인 언어의 받아쓰기를 사용할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado não está disponível para o seu idioma neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备暂不支持你所用语言的听写。"
          }
        }
      }
    },
