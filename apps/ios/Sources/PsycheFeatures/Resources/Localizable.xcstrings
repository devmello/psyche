            "value": "{name}が自分自身を削除しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}이(가) 스스로 제거되었습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} se removeu sozinho"
          }
        },
        "zh-Hans": {
          "stringUnit": {
