          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 페어링 코드를 읽었어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de pareamento lido do seu Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取你的 Mac 上的配对码"
          }
        }
      }
    },
    "If your Mac asks, approve %@. It gets read, write and approvals, not admin.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your Mac asks, approve %@. It gets read, write and approvals, not admin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا سألك جهاز Mac، فوافق على %@. يحصل على القراءة والكتابة والموافقات، وليس صلاحيات المسؤول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Mac fragt, gib %@ frei. Es bekommt Lesen, Schreiben und Freigaben, keinen Admin-Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu Mac lo pide, aprueba %@. Obtiene lectura, escritura y aprobaciones, no administración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ton Mac le demande, approuve %@. Il obtient la lecture, l’écriture et les approbations, pas l’administration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपका Mac पूछे, तो %@ को स्वीकृति दें। इसे पढ़ने, लिखने और स्वीकृतियों की अनुमति मिलती है, एडमिन की नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il Mac lo chiede, approva %@. Ottiene lettura, scrittura e approvazioni, non amministrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac から尋ねられたら %@ を承認してください。読み取り、書き込み、承認の権限が付与され、管理者権限は付与されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 물으면 %@을(를) 승인하세요. 읽기, 쓰기, 승인 권한을 받으며 관리자 권한은 받지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu Mac perguntar, aprove %@. Ele recebe leitura, escrita e aprovações, não administração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 Mac 询问，请批准 %@。它将获得读取、写入和审批权限，没有管理员权限。"
          }
        }
      }
    },
