    "It came from outside, so it's quarantined on your Mac. Trust it there to open it here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاء هذا الملف من خارج جهازك، لذا هو في الحجر على جهاز Mac. ثِق به هناك لفتحه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei stammt von außen und ist deshalb auf deinem Mac in Quarantäne. Vertrau ihr dort, um sie hier zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It came from outside, so it's quarantined on your Mac. Trust it there to open it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó desde fuera, así que está en cuarentena en tu Mac. Confíale allí para abrirlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vient de l'extérieur, il est donc en quarantaine sur ton Mac. Fais-lui confiance là-bas pour l'ouvrir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बाहर से आया है, इसलिए यह आपके Mac पर क्वारंटीन में है। यहाँ खोलने के लिए वहाँ इस पर भरोसा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva dall'esterno, quindi è in quarantena sul tuo Mac. Dagli fiducia lì per aprirlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部から届いたため、Mac で隔離されています。ここで開くには、Mac で信頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부에서 받은 파일이라 Mac에서 격리되어 있습니다. 여기서 열려면 Mac에서 신뢰하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veio de fora, então está em quarentena no seu Mac. Confie nele lá para abri-lo aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件来自外部，因此在你的 Mac 上被隔离。请在 Mac 上信任它，才能在这里打开。"
          }
        }
      }
    },
    "It's bigger than 64 MB, so it opens on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجمه أكبر من 64 ميغابايت، لذا يُفتح على جهاز Mac."
