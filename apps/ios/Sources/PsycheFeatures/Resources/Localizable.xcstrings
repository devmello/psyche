    "Psyche on your Mac is asking whether to let this phone in. Check that the code matches.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche on your Mac is asking whether to let this phone in. Check that the code matches."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل Psyche على جهاز Mac إن كان سيُسمح لهذا الهاتف بالدخول. تحقّق من تطابق الرمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche auf deinem Mac fragt, ob dieses iPhone zugelassen werden soll. Prüfe, ob der Code übereinstimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche en tu Mac pregunta si dejar entrar a este teléfono. Comprueba que el código coincida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche sur ton Mac demande si ce téléphone peut se connecter. Vérifie que le code correspond."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac पर Psyche पूछ रहा है कि इस फ़ोन को आने दिया जाए या नहीं। जाँचें कि कोड मेल खाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche sul Mac chiede se far entrare questo telefono. Controlla che il codice corrisponda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の Psyche が、この iPhone を許可するか確認しています。コードが一致するか確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Psyche가 이 휴대폰을 허용할지 묻고 있습니다. 코드가 일치하는지 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche no seu Mac pergunta se deve deixar este telefone entrar. Confira se o código é o mesmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 上的 Psyche 正在询问是否允许此手机接入。请核对代码是否一致。"
          }
        }
      }
    },
    "Psyche stops where it is. Work already done stays.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche stops where it is. Work already done stays."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف Psyche عند هذه النقطة. يبقى العمل المنجز كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche hält an dieser Stelle an. Bereits erledigte Arbeit bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche se detiene donde está. El trabajo ya hecho se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche s'arrête là où il en est. Le travail déjà fait est conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche जहाँ है वहीं रुक जाता है। जो काम हो चुका है, वह बना रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche si ferma dove si trova. Il lavoro già svolto resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche はその時点で停止します。完了済みの作業は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 있던 자리에서 멈춥니다. 이미 끝난 작업은 남습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche para onde está. O trabalho já feito fica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 会停在当前位置，已完成的工作会保留。"
          }
        }
      }
    },
