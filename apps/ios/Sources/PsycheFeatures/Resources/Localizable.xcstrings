    "notice.security.resealed.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {بدأ Psyche من نسخة احتياطية مستعادة وختم سجلات الأمان كما هي. إن لم تستعد نسخة احتياطية، فراجع أجهزتك.} other {ختم Psyche سجلات الأمان لديه من جديد بعد فترة الانتظار.}}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche wurde aus einem wiederhergestellten Backup gestartet und hat seine Sicherheitsdaten so versiegelt, wie sie sind. Wenn du kein Backup wiederhergestellt hast, prüfe deine Geräte.} other {Psyche hat seine Sicherheitsdaten nach der Wartezeit erneut versiegelt.}}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche started from a restored backup and sealed its security records as they are. If you did not restore a backup, check your devices.} other {Psyche sealed its security records again after the waiting period.}}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche arrancó desde una copia restaurada y selló sus registros de seguridad tal como están. Si no restauraste ninguna copia, revisa tus dispositivos.} other {Psyche selló de nuevo sus registros de seguridad tras el periodo de espera.}}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche a démarré depuis une sauvegarde restaurée et a scellé ses enregistrements de sécurité tels quels. Si vous n’avez pas restauré de sauvegarde, vérifiez vos appareils.} other {Psyche a scellé à nouveau ses enregistrements de sécurité après le délai d’attente.}}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche रिस्टोर किए गए बैकअप से शुरू हुआ और उसने सुरक्षा रिकॉर्ड जैसे हैं वैसे ही सील कर दिए। अगर आपने बैकअप रिस्टोर नहीं किया, तो अपने डिवाइस देखें।} other {प्रतीक्षा अवधि के बाद Psyche ने अपने सुरक्षा रिकॉर्ड फिर से सील कर दिए।}}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche è partito da un backup ripristinato e ha sigillato i suoi registri di sicurezza così come sono. Se non hai ripristinato un backup, controlla i tuoi dispositivi.} other {Psyche ha sigillato di nuovo i suoi registri di sicurezza dopo il periodo di attesa.}}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche は復元されたバックアップから起動し、セキュリティ記録をそのまま保護しました。バックアップを復元していない場合は、デバイスを確認してください。} other {Psyche は待機期間の後、セキュリティ記録を再び保護しました。}}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche가 복원된 백업에서 시작되어 보안 기록을 현재 상태 그대로 봉인했습니다. 백업을 복원하지 않았다면 기기를 확인하세요.} other {Psyche가 대기 기간이 지난 뒤 보안 기록을 다시 봉인했습니다.}}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {O Psyche iniciou a partir de um backup restaurado e selou seus registros de segurança como estão. Se você não restaurou um backup, revise seus dispositivos.} other {O Psyche selou seus registros de segurança de novo após o período de espera.}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{restored, select, yes {Psyche 从恢复的备份启动，并按现状封存了安全记录。如果你没有恢复过备份，请检查你的设备。} other {等待期结束后，Psyche 已重新封存安全记录。}}"
          }
        }
      }
    },
