    "Psyche needs two contact details to split a person. Merging brings them together.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche needs two contact details to split a person. Merging brings them together."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Psyche إلى تفصيلتين للتواصل لفصل شخص. الدمج يجمعهما معاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufteilen braucht Psyche zwei Kontaktdaten. Beim Zusammenführen kommen sie zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche necesita dos datos de contacto para separar a una persona. Combinar los une."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche a besoin de deux coordonnées pour séparer une personne. La fusion les réunit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी व्यक्ति को अलग करने के लिए Psyche को दो संपर्क विवरण चाहिए। मिलाने पर वे एक साथ आ जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per separare una persona servono due recapiti. Unendo le persone, i recapiti si uniscono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人を分割するには連絡先が2つ必要です。統合すると連絡先がまとまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람을 나누려면 연락처가 두 개 필요합니다. 합치면 연락처가 함께 모입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche precisa de dois contatos para separar uma pessoa. Mesclar as junta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分人物需要至少两个联系方式。合并后，联系方式会集中在一起。"
