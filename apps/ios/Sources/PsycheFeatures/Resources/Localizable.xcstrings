        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Psyche आपके लिए कुछ करता है, तो रसीदें यहाँ दिखती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricevute compaiono qui quando Psyche agisce per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche があなたの代わりに何かを行うと、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 대신 무언가를 하면 영수증이 여기에 표시됩니다."
          }
        },
        "pt": {
