    "It becomes the latest version. Nothing is deleted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It becomes the latest version. Nothing is deleted."
          }
        },
        "ar": {
          "stringUnit": {
