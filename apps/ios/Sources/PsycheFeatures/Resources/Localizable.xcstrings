    "Without an Apple Developer account, Psyche can only notify you while it's open or when iOS lets it check in the background.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an Apple Developer account, Psyche can only notify you while it's open or when iOS lets it check in the background."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون حساب Apple Developer، يمكن لـ Psyche إشعارك فقط أثناء فتحه أو عندما يسمح له iOS بالتحقق في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Apple-Developer-Konto kann Psyche dich nur benachrichtigen, während es geöffnet ist oder wenn iOS ihm erlaubt, im Hintergrund zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin una cuenta de Apple Developer, Psyche solo puede avisarte mientras está abierto o cuando iOS le deja comprobar en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans compte Apple Developer, Psyche ne peut te notifier que lorsqu'il est ouvert ou quand iOS lui permet de vérifier en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Developer खाते के बिना, Psyche केवल तब सूचित कर सकता है जब वह खुला हो या जब iOS उसे बैकग्राउंड में जाँचने दे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un account Apple Developer, Psyche può avvisarti solo mentre è aperto o quando iOS gli permette di controllare in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Developer アカウントがない場合、Psyche が通知できるのはアプリを開いている間か、iOS がバックグラウンドでの確認を許可した時だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Developer 계정이 없으면 Psyche는 앱이 열려 있거나 iOS가 백그라운드 확인을 허용할 때만 알릴 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem uma conta Apple Developer, o Psyche só pode avisar você enquanto estiver aberto ou quando o iOS permitir verificar em segundo plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 Apple Developer 账户时，Psyche 只能在打开时或 iOS 允许后台检查时通知你。"
          }
        }
      }
    },
