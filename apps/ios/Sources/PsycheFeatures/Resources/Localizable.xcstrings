    "The Mac that answered isn't the one this phone was paired with, so Psyche stopped. Nothing was sent to it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac that answered isn't the one this phone was paired with, so Psyche stopped. Nothing was sent to it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز الذي ردّ ليس الجهاز الذي اقترن به هذا الهاتف، لذلك توقف Psyche. لم يُرسل إليه شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der antwortende Mac ist nicht der, mit dem dieses iPhone gekoppelt ist. Psyche hat daher angehalten. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac que respondió no es el que emparejó este teléfono, así que Psyche se detuvo. No se envió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac qui a répondu n'est pas celui auquel ce téléphone est associé, Psyche s'est donc arrêté. Rien n'a été envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस Mac ने जवाब दिया, वह इस फ़ोन से पेयर किया गया Mac नहीं है, इसलिए Psyche रुक गया। कुछ भी नहीं भेजा गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac che ha risposto non è quello abbinato a questo telefono, quindi Psyche si è fermato. Non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答した Mac はこの iPhone とペアリングされたものではないため、Psyche は停止しました。何も送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답한 Mac은 이 휴대폰과 페어링된 Mac이 아니므로 Psyche가 중단되었습니다. 아무것도 전송되지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac que respondeu não é o que este telefone pareou, então o Psyche parou. Nada foi enviado a ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回应的 Mac 不是此手机配对的那台，因此 Psyche 已停止。没有向它发送任何内容。"
          }
        }
      }
    },
