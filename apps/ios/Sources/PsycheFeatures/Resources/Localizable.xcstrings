    "Set a passcode on this phone to allow this here, or answer on your Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode on this phone to allow this here, or answer on your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط رمز مرور على هذا الهاتف للسماح بهذا هنا، أو أجب على جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege auf diesem iPhone einen Code fest, um dies hier zu erlauben, oder antworte auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define un código en este teléfono para permitirlo aquí, o responde en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis un code sur ce téléphone pour l'autoriser ici, ou réponds sur ton Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इसकी अनुमति देने के लिए इस फ़ोन पर पासकोड सेट करें, या अपने Mac पर उत्तर दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un codice su questo telefono per consentirlo qui, oppure rispondi sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで許可するにはこの iPhone にパスコードを設定するか、Mac で回答してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 허용하려면 이 휴대폰에 암호를 설정하거나 Mac에서 답하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um código neste telefone para permitir aqui, ou responda no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在此处允许，请为此手机设置密码，或在 Mac 上回答。"
          }
        }
      }
    },
