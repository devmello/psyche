    "Allow the microphone for Psyche in Settings to record a voice memo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone for Psyche in Settings to record a voice memo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Psyche بالوصول إلى الميكروفون في الإعدادات لتسجيل مذكرة صوتية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Psyche in den Einstellungen den Zugriff auf das Mikrofon, um eine Sprachnotiz aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Psyche use el micrófono en Ajustes para grabar una nota de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le micro pour Psyche dans Réglages pour enregistrer un mémo vocal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस मेमो रिकॉर्ड करने के लिए सेटिंग्स में Psyche को माइक्रोफ़ोन की अनुमति दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Psyche l’uso del microfono nelle Impostazioni per registrare una nota vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスメモを録音するには、設定で Psyche のマイクへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메모를 녹음하려면 설정에서 Psyche의 마이크 사용을 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o microfone para o Psyche em Ajustes para gravar um memo de voz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Psyche 使用麦克风，以录制语音备忘。"
          }
        }
      }
    },
