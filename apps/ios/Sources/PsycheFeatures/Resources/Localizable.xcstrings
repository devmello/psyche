    "notice.approvals.resumeMissed.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{automation, select, none {لم يُنفَّذ إجراء أتمتة تمت الموافقة عليه} other {{automation}: لم يُنفَّذ الإجراء الذي تمت الموافقة عليه}}"
          }
        },
        "de": {
