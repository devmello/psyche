    "Psyche isn't sure of these. Confirm what's right, or leave the rest for now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche isn't sure of these. Confirm what's right, or leave the rest for now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche غير متأكد من هذه. أكّد الصحيح، واترك الباقي الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ist sich hier nicht sicher. Bestätige, was stimmt, und lass den Rest vorerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche no está seguro de estas. Confirma lo que es correcto y deja el resto por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche n'en est pas sûr. Confirmez ce qui est juste et laissez le reste pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche को इन पर भरोसा नहीं है। जो सही है उसकी पुष्टि करें, बाकी अभी छोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche non ne è sicuro. Conferma ciò che è giusto e lascia il resto per ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche はこれらに確信がありません。正しいものは確認し、残りは今は保留してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 확신하지 못하는 내용입니다. 맞는 것은 확인하고 나머지는 나중에 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Psyche não tem certeza disto. Confirme o que está certo e deixe o resto para depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 不太确定这些内容。确认正确的，其余的先保留。"
          }
        }
      }
    },
