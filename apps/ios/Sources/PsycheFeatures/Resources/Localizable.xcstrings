    "notice.connector.consent.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح هذا الرابط على الكمبيوتر الذي يعمل عليه Psyche لمنح الوصول: {url}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne diesen Link auf dem Computer, auf dem Psyche läuft, um den Zugriff zu erlauben: {url}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this link on the computer running Psyche to grant access: {url}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre este enlace en el ordenador donde se ejecuta Psyche para dar acceso: {url}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ce lien sur l’ordinateur où Psyche s’exécute pour accorder l’accès : {url}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँच देने के लिए यह लिंक उस कंप्यूटर पर खोलें जिस पर Psyche चल रहा है: {url}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri questo link sul computer su cui è in esecuzione Psyche per concedere l’accesso: {url}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可するには、Psyche が動いているコンピュータでこのリンクを開いてください: {url}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근을 허용하려면 Psyche가 실행 중인 컴퓨터에서 이 링크를 여세요: {url}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra este link no computador onde o Psyche está rodando para conceder acesso: {url}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在运行 Psyche 的电脑上打开此链接以授予访问权限：{url}"
          }
        }
      }
    },
    "notice.connector.reconnect.title": {
