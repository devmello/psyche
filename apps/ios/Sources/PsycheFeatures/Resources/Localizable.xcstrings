    "notice.apiKey.changed.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {{action, select, changed {تم تغيير} other {تمت إزالة}} مفتاح {provider}} other {{action, select, changed {تم تغيير} other {تمت إزالة}} مفتاح API الخاص بـ {provider}}}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {Der {provider}-Schlüssel wurde {action, select, changed {geändert} other {entfernt}}} other {Der {provider}-API-Schlüssel wurde {action, select, changed {geändert} other {entfernt}}}}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {The {provider} key was {action, select, changed {changed} other {removed}}} other {The {provider} API key was {action, select, changed {changed} other {removed}}}}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {La clave de {provider} se {action, select, changed {cambió} other {eliminó}}} other {La clave de API de {provider} se {action, select, changed {cambió} other {eliminó}}}}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {La clé {provider} a été {action, select, changed {modifiée} other {supprimée}}} other {La clé API {provider} a été {action, select, changed {modifiée} other {supprimée}}}}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {{provider} कुंजी {action, select, changed {बदली गई} other {हटाई गई}}} other {{provider} API कुंजी {action, select, changed {बदली गई} other {हटाई गई}}}}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {La chiave {provider} è stata {action, select, changed {modificata} other {rimossa}}} other {La chiave API di {provider} è stata {action, select, changed {modificata} other {rimossa}}}}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {{provider} のキーが{action, select, changed {変更} other {削除}}されました} other {{provider} の API キーが{action, select, changed {変更} other {削除}}されました}}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {{provider} 키가 {action, select, changed {변경} other {삭제}}되었습니다} other {{provider} API 키가 {action, select, changed {변경} other {삭제}}되었습니다}}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {A chave do {provider} foi {action, select, changed {alterada} other {removida}}} other {A chave de API do {provider} foi {action, select, changed {alterada} other {removida}}}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{kind, select, brave {{provider} 密钥已{action, select, changed {更改} other {移除}}} other {{provider} API 密钥已{action, select, changed {更改} other {移除}}}}"
          }
        }
      }
    },
    "notice.apiKey.changed.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{action, select, changed {التغيير} other {الإزالة}} من {device, select, none {جهاز} other {\"{device}\" ({platform}{paired, select, none {} other {، اقترن في {paired}}})}}. إن لم تكن أنت من فعل ذلك، فألغِ الجهاز من الإعدادات ← الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{action, select, changed {Geändert} other {Entfernt}} von {device, select, none {einem Gerät} other {\"{device}\" ({platform}{paired, select, none {} other {, gekoppelt am {paired}}})}}. Wenn du das nicht warst, widerrufe das Gerät unter Einstellungen → Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{action, select, changed {Changed} other {Removed}} from {device, select, none {a device} other {\"{device}\" ({platform}{paired, select, none {} other {, paired {paired}}})}}. If that was not you, revoke the device in Settings → Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{action, select, changed {Cambiada} other {Eliminada}} desde {device, select, none {un dispositivo} other {\"{device}\" ({platform}{paired, select, none {} other {, vinculado el {paired}}})}}. Si no fuiste tú, revoca el dispositivo en Ajustes → Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{action, select, changed {Modifiée} other {Supprimée}} depuis {device, select, none {un appareil} other {\"{device}\" ({platform}{paired, select, none {} other {, associé le {paired}}})}}. Si ce n’était pas vous, révoquez l’appareil dans Réglages → Appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{action, select, changed {बदलाव} other {हटाना}} इस डिवाइस से हुआ: {device, select, none {एक डिवाइस} other {\"{device}\" ({platform}{paired, select, none {} other {, पेयर किया गया {paired}}})}}। अगर यह आपने नहीं किया, तो सेटिंग → डिवाइस में उस डिवाइस को रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
