        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 더 이상 Psyche의 동작에 영향을 주지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
