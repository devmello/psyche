            "value": "Apri Psyche per rispondere a questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psycheを開いて回答してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche를 열어 이 요청에 응답하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Psyche para responder a esta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Psyche 来回答这一项。"
          }
        }
      }
    },
    "This one needs your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الطلب يحتاج إلى جهاز Mac الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das braucht deinen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one needs your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta necesita tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celle-ci demande votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए आपका Mac चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiede il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはMacでの操作が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 Mac에서 처리해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta precisa do seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一项需要在你的 Mac 上处理。"
          }
        }
      }
    },
    "This one needs your Mac. Answer it there.": {
      "extractionState": "manual",
      "localizations": {
