    "Reads your memory, calendar, mail and the web. Changes nothing until you take a plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your memory, calendar, mail and the web. Changes nothing until you take a plan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقرأ ذاكرتك وتقويمك وبريدك والويب. لا تغيّر شيئًا حتى تتبنى خطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest dein Gedächtnis, deinen Kalender, deine Mails und das Web. Ändert nichts, bis du einen Plan übernimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee tu memoria, calendario, correo y la web. No cambia nada hasta que elijas un plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit votre mémoire, agenda, courrier et le web. Ne change rien tant que vous n'adoptez pas un plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मेमोरी, कैलेंडर, मेल और वेब पढ़ती है। योजना अपनाने तक कुछ नहीं बदलती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge memoria, calendario, posta e web. Non cambia nulla finché non scegli un piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ、カレンダー、メール、ウェブを読みます。プランを採用するまで何も変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리, 캘린더, 메일, 웹을 읽습니다. 계획을 선택하기 전에는 아무것도 바꾸지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê sua memória, agenda, e-mail e a web. Não muda nada até você adotar um plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会读取你的记忆、日历、邮件和网页。在你采用方案前不会改动任何东西。"
          }
        }
      }
    },
    "Tick what Psyche should apply now. Nothing is sent unless you tick Send it too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick what Psyche should apply now. Nothing is sent unless you tick Send it too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد ما تطبّقه Psyche الآن. لن يُرسل شيء ما لم تحدد «أرسله أيضًا»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake an, was Psyche jetzt anwenden soll. Nichts wird gesendet, außer du hakst „Auch senden“ an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo que Psyche debe aplicar ahora. No se envía nada salvo que marques «Enviarlo también»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez ce que Psyche doit appliquer maintenant. Rien n'est envoyé sans « L'envoyer aussi »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि Psyche अभी क्या लागू करे। “इसे भी भेजें” चुने बिना कुछ नहीं भेजा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta ciò che Psyche deve applicare ora. Non viene inviato nulla senza «Invia anche»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今Psycheに適用してほしいものにチェックを入れてください。「送信も行う」にチェックしない限り、何も送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 지금 적용할 항목을 선택하세요. “함께 보내기”를 선택하지 않으면 아무것도 전송되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que a Psyche deve aplicar agora. Nada é enviado sem marcar “Enviar também”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选 Psyche 现在要执行的内容。不勾选“同时发送”就不会发送任何东西。"
          }
        }
      }
    },
    "Psyche starts on the remaining steps, asking before each action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche starts on the remaining steps, asking before each action"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ Psyche بالخطوات المتبقية وتسأل قبل كل إجراء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche beginnt mit den übrigen Schritten und fragt vor jeder Aktion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche empieza con los pasos restantes y pregunta antes de cada acción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche passe aux étapes restantes et demande avant chaque action"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche बाकी चरण शुरू करती है और हर कार्य से पहले पूछती है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche inizia i passaggi restanti e chiede prima di ogni azione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psycheが残りの手順を進め、各操作の前に確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 남은 단계를 시작하며 각 작업 전에 묻습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Psyche começa os passos restantes e pergunta antes de cada ação"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 开始执行剩余步骤，每项操作前都会询问"
          }
        }
      }
    },
