          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يُفتح على هاتفك. اقرأه في Psyche على جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wird nicht auf deinem iPhone geöffnet. Lies es in Psyche auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se abre en tu teléfono. Léelo en Psyche en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ne s'ouvre pas sur ton téléphone. Lis-le dans Psyche sur ton Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके फ़ोन पर नहीं खुलता। इसे अपने Mac पर Psyche में पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non si apre sul telefono. Leggilo in Psyche sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは iPhone では開けません。Mac の Psyche で読んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 휴대폰에서 열리지 않습니다. Mac의 Psyche에서 읽으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não abre no seu telefone. Leia no Psyche no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
