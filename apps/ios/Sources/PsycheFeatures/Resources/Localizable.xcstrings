    "Its messages go, and Psyche starts fresh in this chat. The title and receipts stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its messages go, and Psyche starts fresh in this chat. The title and receipts stay."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف رسائلها، ويبدأ Psyche من جديد في هذه المحادثة. يبقى العنوان والإيصالات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachrichten werden gelöscht, und Psyche beginnt in diesem Chat neu. Titel und Belege bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus mensajes se borran y Psyche empieza de cero en este chat. El título y los recibos se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses messages sont supprimés et Psyche repart de zéro dans cette conversation. Le titre et les reçus restent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके संदेश हट जाएंगे, और Psyche इस चैट में नए सिरे से शुरू करेगा। शीर्षक और रसीदें रहेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi vengono eliminati e Psyche ricomincia da capo in questa chat. Titolo e ricevute restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは消去され、このチャットで Psyche は最初から始めます。タイトルと受け取りは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 삭제되고 Psyche는 이 채팅에서 새로 시작합니다. 제목과 영수증은 남습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens são apagadas e o Psyche recomeça nesta conversa. O título e os recibos ficam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息会被删除,Psyche 将在此对话中重新开始。标题和回执会保留。"
          }
        }
      }
    },
