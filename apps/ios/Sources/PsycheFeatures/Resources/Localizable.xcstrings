    "It's removed from your Library on your Mac too. Chats that used it keep their copy of the text.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed from your Library on your Mac too. Chats that used it keep their copy of the text."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل من مكتبتك على Mac أيضاً. تحتفظ المحادثات التي استخدمته بنسختها من النص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch aus deiner Bibliothek auf dem Mac entfernt. Chats, die sie verwendet haben, behalten ihre Textkopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se elimina de tu biblioteca en el Mac. Los chats que lo usaron conservan su copia del texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est aussi retiré de ta bibliothèque sur ton Mac. Les discussions qui l'ont utilisé gardent leur copie du texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके Mac की लाइब्रेरी से भी हट जाता है। जिन चैट में इसका उपयोग हुआ था, वे टेक्स्ट की अपनी प्रति रखती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso anche dalla tua libreria sul Mac. Le chat che lo usavano mantengono la loro copia del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のライブラリからも削除されます。これを使ったチャットには、テキストのコピーが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 보관함에서도 삭제됩니다. 이를 사용한 채팅은 텍스트 사본을 그대로 보관합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também é removido da sua Biblioteca no Mac. Os chats que o usaram mantêm a cópia do texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也会从你 Mac 上的资料库中移除。使用过它的聊天会保留文本副本。"
          }
        }
      }
    },
