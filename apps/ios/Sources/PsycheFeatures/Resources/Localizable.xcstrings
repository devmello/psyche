    "Search your chats, files, people and to-dos, or ask about your life.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search your chats, files, people and to-dos, or ask about your life."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في محادثاتك وملفاتك وأشخاصك ومهامك، أو اسأل عن حياتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche deine Chats, Dateien, Personen und To-dos oder frag nach deinem Alltag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en tus chats, archivos, personas y tareas, o pregunta sobre tu vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche dans tes discussions, fichiers, personnes et tâches, ou pose une question sur ta vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी चैट, फ़ाइलों, लोगों और टू-डू में खोजें, या अपने जीवन के बारे में पूछें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca tra chat, file, persone e cose da fare, oppure chiedi della tua vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット、ファイル、人、To-Do を検索したり、暮らしについて質問したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅, 파일, 사람, 할 일을 검색하거나 일상에 대해 물어보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise em seus chats, arquivos, pessoas e tarefas, ou pergunte sobre sua vida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索你的聊天、文件、人员和待办，或询问你的生活相关问题。"
          }
        }
      }
    },
