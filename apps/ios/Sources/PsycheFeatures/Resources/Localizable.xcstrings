            "value": "Psyche a besoin de vous dans le navigateur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche को ब्राउज़र में आपकी ज़रूरत है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ha bisogno di te nel browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで Psyche の手助けが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 Psyche가 도움을 필요로 합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche precisa de você no navegador"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
