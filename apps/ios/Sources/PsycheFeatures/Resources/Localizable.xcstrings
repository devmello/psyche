    "notice.security.firstSeal.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح Psyche يفحص سجلات الأمان لديه الآن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche prüft jetzt seine Sicherheitsdaten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche now checks its security records"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ahora comprueba sus registros de seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche vérifie désormais ses enregistrements de sécurité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche अब अपने सुरक्षा रिकॉर्ड की जाँच करता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ora controlla i suoi registri di sicurezza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche がセキュリティ記録の確認を開始しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 이제 보안 기록을 확인합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche agora verifica seus registros de segurança"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 现在会检查它的安全记录"
          }
        }
      }
    },
    "notice.security.tightened.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا قلّل فقط ما يُسمح لـ Psyche بفعله، لذلك لم تكن هناك حاجة إلى موافقة. إن لم تكن أنت، فألغِ ربط الجهاز من الإعدادات ← الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nur eingeschränkt, was Psyche darf, deshalb war keine Freigabe nötig. Warst du das nicht, entferne das Gerät unter Einstellungen → Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only reduced what Psyche is allowed to do, so no approval was needed. If that was not you, revoke the device in Settings → Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo redujo lo que Psyche puede hacer, así que no hizo falta aprobación. Si no fuiste tú, revoca el dispositivo en Ajustes → Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a seulement réduit ce que Psyche peut faire, aucune approbation n'était donc nécessaire. Si ce n'était pas vous, révoquez l'appareil dans Réglages → Appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे Psyche को मिली अनुमतियाँ केवल घटीं, इसलिए किसी मंज़ूरी की ज़रूरत नहीं पड़ी। अगर यह आपने नहीं किया, तो सेटिंग्स → डिवाइस में उस डिवाइस को हटा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ha solo ridotto ciò che Psyche può fare, quindi non serviva approvazione. Se non sei stato tu, revoca il dispositivo in Impostazioni → Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psycheができることを減らしただけなので、承認は不要でした。心当たりがない場合は、設定 → デバイスでそのデバイスを取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 할 수 있는 일을 줄이기만 했으므로 승인이 필요하지 않았습니다. 본인이 아니라면 설정 → 기기에서 해당 기기를 해제하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apenas reduziu o que o Psyche pode fazer, então nenhuma aprovação foi necessária. Se não foi você, revogue o dispositivo em Ajustes → Dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只减少了 Psyche 可以做的事，因此无需批准。如果不是你本人操作，请在“设置 → 设备”中撤销该设备。"
          }
        }
      }
    },
    "notice.security.untrusted.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Psyche الوثوق بسجلات الأمان لديه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche kann seinen Sicherheitsdaten nicht vertrauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche cannot trust its security records"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche no puede fiarse de sus registros de seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ne peut pas se fier à ses enregistrements de sécurité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche अपने सुरक्षा रिकॉर्ड पर भरोसा नहीं कर सकता"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche non può fidarsi dei suoi registri di sicurezza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche はセキュリティ記録を信頼できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 보안 기록을 신뢰할 수 없습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche não pode confiar nos seus registros de segurança"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 无法信任它的安全记录"
          }
        }
      }
    },
    "notice.security.untrusted.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل فحص سجلات الأمان في Psyche، لذلك حُظرت التغييرات الأمنية والأجهزة الجديدة وموافقات Touch ID. راجع أجهزتك، ثم شغّل `psyched security reseal` على الـ Mac (يسري بعد 24 ساعة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung von Psyches Sicherheitsdaten ist fehlgeschlagen. Sicherheitsänderungen, neue Geräte und Touch-ID-Freigaben sind deshalb gesperrt. Prüfe deine Geräte und führe dann auf dem Mac `psyched security reseal` aus (es gilt nach 24 Stunden)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche's check of its security records failed, so security changes, new devices and Touch ID approvals are blocked. Review your devices, then run `psyched security reseal` on the Mac (it applies after 24 hours)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación de los registros de seguridad de Psyche falló, así que los cambios de seguridad, los dispositivos nuevos y las aprobaciones con Touch ID están bloqueados. Revisa tus dispositivos y ejecuta `psyched security reseal` en el Mac (se aplica a las 24 horas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification des enregistrements de sécurité de Psyche a échoué : les modifications de sécurité, les nouveaux appareils et les approbations par Touch ID sont bloqués. Vérifiez vos appareils, puis lancez `psyched security reseal` sur le Mac (effectif après 24 heures)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche के सुरक्षा रिकॉर्ड की जाँच विफल रही, इसलिए सुरक्षा बदलाव, नए डिवाइस और Touch ID से मंज़ूरियाँ रोक दी गई हैं। अपने डिवाइस देखें, फिर Mac पर `psyched security reseal` चलाएँ (यह 24 घंटे बाद लागू होता है)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo dei registri di sicurezza di Psyche non è riuscito, quindi le modifiche di sicurezza, i nuovi dispositivi e le approvazioni con Touch ID sono bloccati. Controlla i tuoi dispositivi, poi esegui `psyched security reseal` sul Mac (vale dopo 24 ore)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche のセキュリティ記録の確認に失敗したため、セキュリティ変更、新しいデバイス、Touch ID による承認はブロックされています。デバイスを確認してから、Mac で `psyched security reseal` を実行してください（24 時間後に適用されます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche의 보안 기록 확인에 실패해서 보안 변경, 새 기기, Touch ID 승인이 차단되었습니다. 기기를 확인한 다음 Mac에서 `psyched security reseal`을 실행하세요(24시간 후에 적용됩니다)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação dos registros de segurança do Psyche falhou, então alterações de segurança, novos dispositivos e aprovações com Touch ID estão bloqueados. Revise seus dispositivos e execute `psyched security reseal` no Mac (vale após 24 horas)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 对安全记录的检查未通过，因此安全更改、新设备和 Touch ID 批准都已被阻止。请检查你的设备，然后在 Mac 上运行 `psyched security reseal`（24 小时后生效）。"
          }
        }
      }
    },
