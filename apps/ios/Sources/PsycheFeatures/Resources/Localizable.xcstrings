          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} ने खुद को हटा लिया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} si è rimosso da solo"
          }
        },
        "ja": {
