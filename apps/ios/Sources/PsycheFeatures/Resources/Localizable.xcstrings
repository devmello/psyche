        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 正在操作你的 Chrome"
          }
        }
      }
    },
    "notice.browser.chrome.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم مهمة ملف Chrome الخاص بـ Psyche الذي سجّلت الدخول فيه. عنوان نافذته “Psyche is driving this window”. يُغلق عند انتهاء المهمة، ويمكنك أيضًا إنهاء Chrome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe nutzt das Psyche-Chrome-Profil, in dem du angemeldet bist. Der Fenstertitel lautet „Psyche is driving this window“. Es schließt sich, wenn die Aufgabe fertig ist; du kannst Chrome auch beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task is using the Psyche Chrome profile, where you are signed in. Its window title says “Psyche is driving this window”. It closes when the task is done; you can also quit Chrome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea usa el perfil de Chrome de Psyche, donde tienes la sesión iniciada. El título de su ventana dice “Psyche is driving this window”. Se cierra cuando termina la tarea; también puedes salir de Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche utilise le profil Chrome de Psyche, où vous êtes connecté. Le titre de sa fenêtre indique « Psyche is driving this window ». Elle se ferme à la fin de la tâche ; vous pouvez aussi quitter Chrome."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टास्क Psyche के Chrome प्रोफ़ाइल का उपयोग कर रहा है, जिसमें आप साइन इन हैं। उसकी विंडो के शीर्षक में “Psyche is driving this window” लिखा है। टास्क पूरा होने पर वह बंद हो जाता है; आप Chrome को खुद भी बंद कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività usa il profilo Chrome di Psyche, dove hai effettuato l’accesso. Il titolo della finestra dice “Psyche is driving this window”. Si chiude al termine dell’attività; puoi anche chiudere Chrome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが、サインイン済みの Psyche 用 Chrome プロファイルを使っています。ウィンドウのタイトルは「Psyche is driving this window」です。タスクが終わると閉じます。Chrome を終了することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 로그인되어 있는 Psyche용 Chrome 프로필을 사용하고 있습니다. 창 제목은 “Psyche is driving this window”입니다. 작업이 끝나면 닫히며, Chrome을 직접 종료해도 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa está usando o perfil do Chrome do Psyche, onde você está conectado. O título da janela diz “Psyche is driving this window”. Ela fecha quando a tarefa termina; você também pode sair do Chrome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任务正在使用你已登录的 Psyche Chrome 配置文件。窗口标题为“Psyche is driving this window”。任务完成后会关闭，你也可以退出 Chrome。"
          }
        }
      }
    },
    "notice.browser.takeover.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاجك Psyche في المتصفح"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche braucht dich im Browser"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche needs you in the browser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
