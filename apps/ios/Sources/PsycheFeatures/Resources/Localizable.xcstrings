    "Revoking needs admin access. Use your Mac or an admin phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoking needs admin access. Use your Mac or an admin phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الإلغاء صلاحية المشرف. استخدم جهاز Mac أو هاتفًا بصلاحية المشرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Widerrufen ist Admin-Zugriff nötig. Nutze deinen Mac oder ein Admin-Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar requiere acceso de administrador. Usa tu Mac o un teléfono administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer demande un accès administrateur. Utilise ton Mac ou un téléphone administrateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करने के लिए एडमिन एक्सेस चाहिए। अपने Mac या किसी एडमिन फ़ोन का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per revocare serve l’accesso amministratore. Usa il tuo Mac o un telefono amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消すには管理者権限が必要です。Macか管理者のiPhoneを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해제하려면 관리자 권한이 필요합니다. Mac이나 관리자 전화기를 사용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar exige acesso de administrador. Use seu Mac ou um telefone administrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销需要管理员权限。请使用你的 Mac 或管理员手机。"
          }
        }
      }
    },
    "This phone can't see standing permissions.": {
