    "The change will not be made. If you asked for it on your Mac, you will need to ask again.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change will not be made. If you asked for it on your Mac, you will need to ask again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُجرى التغيير. إذا طلبته على جهاز Mac، فعليك طلبه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wird nicht vorgenommen. Wenn du sie am Mac angefordert hast, musst du sie neu anfordern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio no se hará. Si lo pediste en tu Mac, tendrás que pedirlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement ne sera pas fait. Si tu l'as demandé sur ton Mac, il faudra le redemander."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव नहीं किया जाएगा। अगर आपने इसे अपने Mac पर माँगा था, तो दोबारा माँगना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non verrà fatta. Se l'hai richiesta sul Mac, dovrai richiederla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は行われません。Mac で依頼した場合は、もう一度依頼する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경은 이루어지지 않습니다. Mac에서 요청했다면 다시 요청해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mudança não será feita. Se você pediu no Mac, será preciso pedir de novo."
          }
