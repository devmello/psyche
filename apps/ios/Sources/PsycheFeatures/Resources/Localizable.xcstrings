      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for Face ID before you allow a risky action from this phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
