    "Copy the pairing link on your Mac, then paste it here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ رابط الاقتران على جهاز Mac ثم الصقه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere den Kopplungslink auf deinem Mac und füge ihn hier ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the pairing link on your Mac, then paste it here."
          }
        },
        "es": {
