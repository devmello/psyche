    "notice.attention.paused.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت مؤقتًا قبل {tool} على تطبيق أو موقع حساس إلى أن تعود إلى Psyche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor {tool} auf einer sensiblen App oder Website pausiert, bis du wieder in Psyche bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused before {tool} on a sensitive app or site until you are back in Psyche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa antes de {tool} en una app o sitio sensible hasta que vuelvas a Psyche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause avant {tool} sur une app ou un site sensible, jusqu’à votre retour dans Psyche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी संवेदनशील ऐप या साइट पर {tool} से पहले रोक दिया गया, जब तक आप Psyche में वापस नहीं आते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa prima di {tool} su un’app o un sito sensibile, finché non torni in Psyche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密性の高いアプリやサイトで {tool} の前に一時停止しています。Psyche に戻るまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 앱이나 사이트에서 {tool} 직전에 멈췄습니다. Psyche로 돌아올 때까지 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa antes de {tool} em um app ou site sensível, até você voltar ao Psyche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在敏感的应用或网站上，已在 {tool} 之前暂停，等你回到 Psyche。"
          }
        }
      }
    },
    "notice.browser.chrome.title": {
