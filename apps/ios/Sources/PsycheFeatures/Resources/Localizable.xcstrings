    "What Psyche asked to approve doesn't match what you ticked, so nothing was applied. Review it again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتطابق ما طلبته Psyche للموافقة مع ما حددته، لذا لم يتم تطبيق أي شيء. راجعه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Psyche zur Genehmigung vorlegte, stimmt nicht mit deiner Auswahl überein. Es wurde nichts angewendet. Prüfe es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Psyche asked to approve doesn't match what you ticked, so nothing was applied. Review it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que Psyche pidió aprobar no coincide con lo que marcaste, así que no se aplicó nada. Revísalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Psyche a demandé d’approuver ne correspond pas à votre sélection, donc rien n’a été appliqué. Relisez-le."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ने जिसे मंज़ूर करने को कहा वह आपके चुने हुए से मेल नहीं खाता, इसलिए कुछ भी लागू नहीं हुआ। इसे फिर से देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che Psyche ha chiesto di approvare non corrisponde a ciò che hai selezionato, quindi non è stato applicato nulla. Rivedilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psycheが承認を求めた内容が選択した内容と一致しないため、何も適用されませんでした。もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 승인을 요청한 내용이 선택한 내용과 달라서 아무것도 적용되지 않았습니다. 다시 검토하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a Psyche pediu para aprovar não corresponde ao que você marcou, então nada foi aplicado. Revise de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 请求批准的内容与你勾选的不一致，因此未应用任何更改。请重新审阅。"
          }
        }
      }
    },
