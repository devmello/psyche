    "Live Activities show progress on the Lock Screen, never task titles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities show progress on the Lock Screen, never task titles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الأنشطة الحية التقدم على شاشة القفل، ولا تعرض عناوين المهام أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten zeigen den Fortschritt auf dem Sperrbildschirm, nie Aufgabentitel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Actividades en directo muestran el progreso en la pantalla de bloqueo, nunca los títulos de las tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Live Activities affichent la progression sur l’écran verrouillé, jamais les titres des tâches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव एक्टिविटी लॉक स्क्रीन पर प्रगति दिखाती हैं, कार्य के शीर्षक कभी नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Attività live mostrano l’avanzamento sulla schermata di blocco, mai i titoli delle attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティはロック画面に進行状況を表示し、タスク名は表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 현황은 잠금 화면에 진행 상황만 표시하며 작업 제목은 표시하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Atividades ao Vivo mostram o progresso na tela de bloqueio, nunca os títulos das tarefas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动会在锁定屏幕上显示进度,不会显示任务标题。"
          }
        }
      }
    },
    "Only while Psyche is open on this phone, and only sent to your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while Psyche is open on this phone, and only sent to your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط أثناء فتح Psyche على هذا الهاتف، ويُرسل إلى جهاز Mac فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur solange Psyche auf diesem iPhone geöffnet ist, und nur an deinen Mac gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mientras Psyche está abierto en este teléfono, y solo se envía a tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement quand Psyche est ouvert sur ce téléphone, et envoyée uniquement à votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तब जब Psyche इस फ़ोन पर खुला हो, और केवल आपके Mac को भेजा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mentre Psyche è aperto su questo telefono, e inviata solo al tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンで Psyche を開いている間だけ、位置情報は Mac にのみ送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 Psyche가 열려 있는 동안에만, 그리고 Mac으로만 전송됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente enquanto o Psyche está aberto neste telefone, e enviada apenas ao seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此手机上打开 Psyche 时,且只会发送到你的 Mac。"
          }
        }
      }
    },
    "On your Mac: Settings > Devices > Pair iPhone. Then scan the code.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac: Settings > Devices > Pair iPhone. Then scan the code."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز Mac: الإعدادات > الأجهزة > إقران iPhone. ثم امسح الرمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Mac: Einstellungen > Geräte > iPhone koppeln. Scanne dann den Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac: Ajustes > Dispositivos > Vincular iPhone. Luego escanea el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac : Réglages > Appareils > Associer l’iPhone. Puis scannez le code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर: सेटिंग > डिवाइस > iPhone जोड़ें। फिर कोड स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul tuo Mac: Impostazioni > Dispositivi > Associa iPhone. Poi scansiona il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で:設定 > デバイス > iPhone をペアリング。表示されたコードをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서: 설정 > 기기 > iPhone 페어링. 그런 다음 코드를 스캔하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu Mac: Ajustes > Dispositivos > Parear iPhone. Depois escaneie o código."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上:设置 > 设备 > 配对 iPhone。然后扫描二维码。"
          }
        }
      }
    },
    "This phone can clear its data now. Your Mac keeps listing it until you remove it in Settings > Devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can clear its data now. Your Mac keeps listing it until you remove it in Settings > Devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لهذا الهاتف مسح بياناته الآن. سيبقى مدرجًا على جهاز Mac حتى تزيله من الإعدادات > الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann seine Daten jetzt löschen. Dein Mac führt es weiter auf, bis du es unter Einstellungen > Geräte entfernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono puede borrar sus datos ahora. Tu Mac lo seguirá mostrando hasta que lo quites en Ajustes > Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone peut effacer ses données maintenant. Votre Mac continue de le lister jusqu’à ce que vous le retiriez dans Réglages > Appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन अभी अपना डेटा मिटा सकता है। आपका Mac इसे तब तक सूची में रखेगा जब तक आप इसे सेटिंग > डिवाइस में नहीं हटाते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono può cancellare i suoi dati adesso. Il Mac lo mostra finché non lo rimuovi da Impostazioni > Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは今すぐデータを消去できます。設定 > デバイスで削除するまで、Mac には表示されたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 지금 데이터를 지울 수 있습니다. 설정 > 기기에서 제거하기 전까지 Mac에는 계속 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone pode apagar os dados agora. O Mac continua listando-o até você removê-lo em Ajustes > Dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机现在可以清除自己的数据。在 Mac 的设置 > 设备中移除之前,它仍会显示在列表中。"
          }
        }
      }
    },
    "You can also remove this phone on your Mac: Settings > Devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also remove this phone on your Mac: Settings > Devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا إزالة هذا الهاتف من جهاز Mac: الإعدادات > الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dieses iPhone auch auf deinem Mac entfernen: Einstellungen > Geräte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes quitar este teléfono en tu Mac: Ajustes > Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi retirer ce téléphone sur votre Mac : Réglages > Appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस फ़ोन को अपने Mac पर भी हटा सकते हैं: सेटिंग > डिवाइस।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche rimuovere questo telefono dal Mac: Impostazioni > Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の設定 > デバイスからこのスマートフォンを削除することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서도 이 휴대폰을 제거할 수 있습니다: 설정 > 기기."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode remover este telefone no Mac: Ajustes > Dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在 Mac 上移除此手机:设置 > 设备。"
          }
        }
      }
    },
