          }
        }
      }
    },
    "notice.browser.takeover.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على {host}، يسأل الوكيل: {reason}. تولَّ التحكم في لوحة المتصفح ثم أعده إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf {host} fragt der Agent: {reason}. Übernimm im Browserbereich die Steuerung und gib sie dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On {host}, the agent asks: {reason}. Take control in the browser pane, then hand it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En {host}, el agente pregunta: {reason}. Toma el control en el panel del navegador y luego devuélvelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur {host}, l’agent demande : {reason}. Prenez la main dans le volet du navigateur, puis rendez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} पर एजेंट पूछ रहा है: {reason}। ब्राउज़र पेन में नियंत्रण अपने हाथ में लें, फिर उसे वापस सौंप दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su {host}, l’agente chiede: {reason}. Prendi il controllo nel pannello del browser, poi restituiscilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} でエージェントが尋ねています: {reason}。ブラウザのペインで操作を引き継ぎ、終わったら戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}에서 에이전트가 묻습니다: {reason}. 브라우저 창에서 직접 조작한 뒤 다시 넘겨주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em {host}, o agente pergunta: {reason}. Assuma o controle no painel do navegador e depois devolva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 {host} 上，智能体询问：{reason}。请在浏览器窗格中接管操作，完成后再交还。"
          }
        }
      }
    },
