    "People whose facts Psyche accepts without asking. Sensitive or unsure facts still wait for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People whose facts Psyche accepts without asking. Sensitive or unsure facts still wait for you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشخاص تقبل Psyche معلوماتهم دون سؤال. المعلومات الحساسة أو غير المؤكدة تنتظرك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen, deren Angaben Psyche ohne Nachfrage übernimmt. Heikle oder unsichere Angaben warten weiterhin auf dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas cuyos datos Psyche acepta sin preguntar. Los datos sensibles o inciertos siguen esperando tu revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnes dont Psyche accepte les informations sans demander. Les informations sensibles ou incertaines attendent toujours votre avis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे लोग जिनकी बातें Psyche बिना पूछे स्वीकार करता है। संवेदनशील या अनिश्चित बातें अब भी आपकी प्रतीक्षा करेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persone le cui informazioni Psyche accetta senza chiedere. Le informazioni sensibili o incerte aspettano ancora te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche が確認なしで受け入れる相手です。機密性のあるものや不確かなものは引き続きあなたの確認を待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 묻지 않고 받아들이는 사람들입니다. 민감하거나 불확실한 내용은 여전히 확인을 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas cujos fatos o Psyche aceita sem perguntar. Fatos sensíveis ou incertos ainda esperam por você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 不再询问即接受其信息的人。敏感或不确定的内容仍会等你确认。"
          }
        }
      }
    },
