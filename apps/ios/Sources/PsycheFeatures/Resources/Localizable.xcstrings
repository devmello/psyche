          "stringUnit": {
            "state": "translated",
            "value": "Il vient de l'extérieur, il est donc en quarantaine sur ton Mac. Fais-lui confiance là-bas pour l'ouvrir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बाहर से आया है, इसलिए यह आपके Mac पर क्वारंटीन में है। यहाँ खोलने के लिए वहाँ इस पर भरोसा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva dall'esterno, quindi è in quarantena sul tuo Mac. Dagli fiducia lì per aprirlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部から届いたため、Mac で隔離されています。ここで開くには、Mac で信頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부에서 받은 파일이라 Mac에서 격리되어 있습니다. 여기서 열려면 Mac에서 신뢰하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veio de fora, então está em quarentena no seu Mac. Confie nele lá para abri-lo aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件来自外部，因此在你的 Mac 上被隔离。请在 Mac 上信任它，才能在这里打开。"
          }
        }
      }
    },
    "It's bigger than 64 MB, so it opens on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجمه أكبر من 64 ميغابايت، لذا يُفتح على جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist größer als 64 MB und wird deshalb auf deinem Mac geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's bigger than 64 MB, so it opens on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesa más de 64 MB, así que se abre en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fait plus de 64 Mo, il s'ouvre donc sur ton Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह 64 MB से बड़ा है, इसलिए यह आपके Mac पर खुलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera i 64 MB, quindi si apre sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "64 MB を超えるため、Mac で開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "64MB보다 커서 Mac에서 열립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem mais de 64 MB, então abre no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 64 MB，因此在你的 Mac 上打开。"
          }
        }
      }
    },
