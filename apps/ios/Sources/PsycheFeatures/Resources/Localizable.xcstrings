    "This phone forgets the Mac it was paired with and clears what it saved. Then you scan a new code on your Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone forgets the Mac it was paired with and clears what it saved. Then you scan a new code on your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسى هذا الهاتف جهاز Mac الذي اقترن به ويمسح ما حفظه. ثم تمسح رمزًا جديدًا من جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone vergisst den Mac, mit dem es gekoppelt war, und löscht alles Gespeicherte. Danach scannst du einen neuen Code auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono olvida el Mac con el que estaba emparejado y borra lo que guardó. Después escaneas un código nuevo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone oublie le Mac auquel il était associé et efface ce qu’il avait enregistré. Tu scannes ensuite un nouveau code sur ton Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन उस Mac को भूल जाता है जिससे वह पेयर था और सहेजा हुआ सब मिटा देता है। फिर आप अपने Mac पर नया कोड स्कैन करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono dimentica il Mac a cui era abbinato e cancella ciò che aveva salvato. Poi scansioni un nuovo codice sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は、ペアリングしていた Mac を忘れ、保存したデータを消去します。そのあと、Mac の新しいコードを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 페어링했던 Mac을 잊고 저장한 내용을 지워요. 그런 다음 Mac의 새 코드를 스캔하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone esquece o Mac com o qual estava pareado e apaga o que salvou. Depois você escaneia um novo código no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机会忘记之前配对的 Mac，并清除已保存的内容。然后你在 Mac 上扫描新的代码。"
          }
        }
      }
    },
