          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se abre en tu teléfono. Léelo en Psyche en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
