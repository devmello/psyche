            "value": "{repo} में कोड रन से बनी लॉन्च कॉन्फ़िगरेशन अब भी अपनी जगह पर है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione di avvio di un'esecuzione di codice in {repo} è ancora al suo posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{repo} でのコード実行が作った起動設定がそのまま残っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{repo}에서 코드 실행이 만든 실행 구성이 그대로 남아 있습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração de inicialização de uma execução de código em {repo} continua no lugar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{repo} 中一次代码运行创建的启动配置仍在原处"
          }
        }
      }
    },
