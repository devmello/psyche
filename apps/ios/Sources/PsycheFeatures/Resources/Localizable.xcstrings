    "Couldn't load the prepared items. You can still take the plan without them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the prepared items. You can still take the plan without them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل العناصر الجاهزة. يمكنك تبنّي الخطة دونها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorbereiteten Einträge konnten nicht geladen werden. Du kannst den Plan trotzdem ohne sie übernehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los elementos preparados. Aún puedes elegir el plan sin ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les éléments préparés. Vous pouvez adopter le plan sans eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार आइटम लोड नहीं हो सके। आप उनके बिना भी योजना अपना सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare gli elementi preparati. Puoi comunque scegliere il piano senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備済みの項目を読み込めませんでした。それらなしでプランを採用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 항목을 불러오지 못했습니다. 항목 없이도 계획을 선택할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os itens preparados. Você ainda pode adotar o plano sem eles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载已准备的项目。你仍可不带它们采用方案。"
          }
        }
      }
    },
