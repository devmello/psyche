    "PDFs, slides and notes Psyche reads or writes for you land here. Add one with +, or share it from any app.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFs, slides and notes Psyche reads or writes for you land here. Add one with +, or share it from any app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا ملفات PDF والشرائح والملاحظات التي يقرأها Psyche أو يكتبها لك. أضف واحداً بالزر +، أو شاركه من أي تطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier landen PDFs, Folien und Notizen, die Psyche für dich liest oder schreibt. Füge eine mit + hinzu oder teile sie aus einer beliebigen App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los PDF, diapositivas y notas que Psyche lee o escribe por ti. Añade uno con +, o compártelo desde cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les PDF, diapositives et notes que Psyche lit ou écrit pour toi arrivent ici. Ajoute-en un avec +, ou partage-le depuis n'importe quelle app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche जो PDF, स्लाइड और नोट्स आपके लिए पढ़ता या लिखता है, वे यहाँ आते हैं। + से जोड़ें, या किसी भी ऐप से शेयर करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui arrivano i PDF, le presentazioni e le note che Psyche legge o scrive per te. Aggiungine uno con +, o condividilo da qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche が読み書きする PDF、スライド、メモはここに保存されます。+ で追加するか、任意のアプリから共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 읽거나 써 주는 PDF, 슬라이드, 메모가 여기에 저장됩니다. +로 추가하거나 아무 앱에서나 공유하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFs, slides e notas que o Psyche lê ou escreve para você chegam aqui. Adicione um com +, ou compartilhe de qualquer app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 为你读写的 PDF、幻灯片和笔记会出现在这里。点击 + 添加，或从任何应用分享。"
          }
        }
      }
    },
    "Pages, checklists and small tools Psyche builds for you are kept here.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages, checklists and small tools Psyche builds for you are kept here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ هنا الصفحات وقوائم المراجعة والأدوات الصغيرة التي يبنيها Psyche لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Seiten, Checklisten und kleine Werkzeuge gespeichert, die Psyche für dich baut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se guardan las páginas, listas de verificación y pequeñas herramientas que Psyche crea para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages, listes de contrôle et petits outils que Psyche crée pour toi sont conservés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche आपके लिए जो पेज, चेकलिस्ट और छोटे टूल बनाता है, वे यहाँ रखे जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui sono conservate le pagine, le checklist e i piccoli strumenti che Psyche crea per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche が作成したページ、チェックリスト、小さなツールはここに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 만든 페이지, 체크리스트, 작은 도구가 여기에 보관됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas, checklists e pequenas ferramentas que o Psyche cria para você ficam guardados aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 为你生成的页面、清单和小工具会保存在这里。"
          }
        }
      }
    },
    "Photos you add with + or share from your photo library show up here.": {
