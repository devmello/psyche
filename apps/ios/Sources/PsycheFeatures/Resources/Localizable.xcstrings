    "Tokens and minutes need a whole number above zero. Cost can't be negative.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens and minutes need a whole number above zero. Cost can't be negative."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرموز والدقائق تحتاج إلى عدد صحيح أكبر من صفر. ولا يمكن أن تكون التكلفة سالبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token und Minuten brauchen eine ganze Zahl über null. Die Kosten dürfen nicht negativ sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens y los minutos necesitan un número entero mayor que cero. El coste no puede ser negativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons et les minutes doivent être un nombre entier supérieur à zéro. Le coût ne peut pas être négatif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टोकन और मिनट शून्य से बड़ी पूर्ण संख्या होने चाहिए। लागत ऋणात्मक नहीं हो सकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token e minuti devono essere un numero intero maggiore di zero. Il costo non può essere negativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンと分は0より大きい整数で入力してください。費用はマイナスにできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰과 분은 0보다 큰 정수여야 합니다. 비용은 음수일 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens e minutos precisam de um número inteiro maior que zero. O custo não pode ser negativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌和分钟须为大于零的整数。费用不能为负数。"
          }
        }
      }
    },
    "Psyche keeps each limit within what Settings allow for this role.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche keeps each limit within what Settings allow for this role."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي Psyche كل حد ضمن ما تسمح به الإعدادات لهذا الدور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche hält jedes Limit innerhalb dessen, was die Einstellungen für diese Rolle erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche mantiene cada límite dentro de lo que permiten los Ajustes para este rol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche garde chaque limite dans ce que les Réglages autorisent pour ce rôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche हर सीमा को इस भूमिका के लिए सेटिंग्स में दी गई सीमा के भीतर रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche mantiene ogni limite entro quanto consentono le Impostazioni per questo ruolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche は各上限を、この役割に対して設定で許可された範囲内に収めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche는 각 한도를 이 역할에 대해 설정에서 허용한 범위 안에 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche mantém cada limite dentro do que os Ajustes permitem para este papel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 会将每项限额控制在“设置”为此角色允许的范围内。"
          }
        }
      }
    },
    "A deadline has to be later than now.": {
      "extractionState": "manual",
