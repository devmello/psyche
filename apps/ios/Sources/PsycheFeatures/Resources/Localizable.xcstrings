    "Psyche reaches your Mac over Tailscale when you're away. Answers wait until it's on.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche reaches your Mac over Tailscale when you're away. Answers wait until it's on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل Psyche إلى جهاز Mac عبر Tailscale عندما تكون بعيداً. تنتظر الردود حتى يُشغَّل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche erreicht deinen Mac über Tailscale, wenn du unterwegs bist. Antworten warten, bis es eingeschaltet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche se conecta a tu Mac por Tailscale cuando estás fuera. Las respuestas esperan a que esté encendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche rejoint ton Mac via Tailscale quand tu es absent. Les réponses attendent qu'il soit allumé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप बाहर होते हैं, तब Psyche Tailscale के ज़रिए आपके Mac तक पहुँचता है। चालू होने तक जवाब रुके रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei fuori, Psyche raggiunge il Mac tramite Tailscale. Le risposte attendono che sia acceso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出時は Tailscale 経由で Mac に接続します。Mac がオンになるまで回答は待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부에 있을 때 Psyche는 Tailscale로 Mac에 연결합니다. 켜질 때까지 답변을 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você está fora, o Psyche alcança seu Mac pelo Tailscale. As respostas esperam até ele ser ligado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你外出时，Psyche 通过 Tailscale 连接你的 Mac。在开启前，回答会等待。"
          }
        }
      }
    },
    "Psyche uses the camera only to read this code. Nothing is recorded.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche uses the camera only to read this code. Nothing is recorded."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Psyche الكاميرا فقط لقراءة هذا الرمز. لا يتم تسجيل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche nutzt die Kamera nur, um diesen Code zu lesen. Nichts wird aufgezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche usa la cámara solo para leer este código. No se graba nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche utilise la caméra uniquement pour lire ce code. Rien n'est enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche कैमरे का उपयोग केवल इस कोड को पढ़ने के लिए करता है। कुछ भी रिकॉर्ड नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche usa la fotocamera solo per leggere questo codice. Non viene registrato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche はこのコードを読み取るためだけにカメラを使います。何も記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche는 이 코드를 읽는 데만 카메라를 사용합니다. 아무것도 기록되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche usa a câmera apenas para ler este código. Nada é gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 仅使用相机读取此代码，不会录制任何内容。"
          }
        }
      }
    },
