    "notice.machine.removed.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان جهاز كمبيوتر يمكن لـ Psyche استخدامه. لن يستخدمه Psyche مجدداً ما لم تضفه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war ein Computer, den Psyche nutzen konnte. Psyche nutzt ihn nicht wieder, solange du ihn nicht erneut hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was a computer Psyche could use. Psyche won't use it again unless you add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Era un ordenador que Psyche podía usar. Psyche no lo usará de nuevo a menos que lo añadas otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était un ordinateur que Psyche pouvait utiliser. Psyche ne l'utilisera plus tant que vous ne l'aurez pas ajouté de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐसा कंप्यूटर था जिसे Psyche इस्तेमाल कर सकता था। जब तक आप इसे दोबारा नहीं जोड़ेंगे, Psyche इसे इस्तेमाल नहीं करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era un computer che Psyche poteva usare. Psyche non lo userà più finché non lo aggiungi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche が使えるコンピュータでした。もう一度追加しない限り、Psyche はこのコンピュータを使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche가 사용할 수 있던 컴퓨터입니다. 다시 추가하지 않으면 Psyche는 이 컴퓨터를 사용하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Era um computador que o Psyche podia usar. O Psyche não vai usá-lo de novo, a menos que você o adicione outra vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它曾是 Psyche 可以使用的电脑。除非你重新添加，否则 Psyche 不会再使用它。"
          }
        }
      }
    },
