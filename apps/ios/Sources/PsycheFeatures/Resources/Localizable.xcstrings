    "notice.machine.offline.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Psyche استخدامه حتى يعاود الاتصال. المهام التي تحتاج إليه تنتظرك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche kann es nicht nutzen, bis es sich wieder verbindet. Aufgaben, die es brauchen, warten auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche can't use it until it reconnects. Tasks that need it wait for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche no puede usarlo hasta que se reconecte. Las tareas que lo necesitan esperan por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ne peut pas l'utiliser avant sa reconnexion. Les tâches qui en ont besoin t'attendent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा कनेक्ट होने तक Psyche इसे इस्तेमाल नहीं कर सकता। जिन टास्क को इसकी ज़रूरत है, वे आपका इंतज़ार करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche non può usarlo finché non si riconnette. Le attività che ne hanno bisogno aspettano te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続するまでPsycheは使えません。必要とするタスクは、あなたを待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결될 때까지 Psyche가 사용할 수 없습니다. 필요한 작업은 사용자를 기다립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche não pode usá-lo até que ele se reconecte. As tarefas que precisam dele esperam por você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接前 Psyche 无法使用它。需要它的任务会等你处理。"
          }
        }
      }
    },
    "notice.approvals.digest.body": {
