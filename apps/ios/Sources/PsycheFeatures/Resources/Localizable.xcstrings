    },
    "Nothing is waiting any more. It was already applied or cancelled.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is waiting any more. It was already applied or cancelled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء ينتظر بعد الآن. فقد طُبّق الطلب أو أُلغي بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet mehr. Die Anfrage wurde schon angewendet oder abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no hay nada en espera. La solicitud ya se aplicó o se canceló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rien n'est en attente. La demande a déjà été appliquée ou annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब कुछ प्रतीक्षा में नहीं है। अनुरोध पहले ही लागू या रद्द हो चुका है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è più nulla in attesa. La richiesta è già stata applicata o annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中のものはありません。すでに適用またはキャンセルされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 대기 중인 요청이 없습니다. 이미 적용되었거나 취소되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais nada em espera. O pedido já foi aplicado ou cancelado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已没有等待中的请求，它已被应用或取消。"
          }
        }
      }
    },
