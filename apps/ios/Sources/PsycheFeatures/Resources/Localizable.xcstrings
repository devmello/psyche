    "Your Mac is only reachable on your home network. Answers wait until you're back, or turn on Tailscale.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is only reachable on your home network. Answers wait until you're back, or turn on Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Mac متاح فقط على شبكتك المنزلية. تنتظر الردود حتى تعود، أو شغّل Tailscale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac ist nur im Heimnetz erreichbar. Antworten warten, bis du zurück bist, oder schalte Tailscale ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac solo es accesible en tu red doméstica. Las respuestas esperan a que vuelvas, o activa Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Mac n'est joignable que sur ton réseau domestique. Les réponses attendent ton retour, ou active Tailscale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac केवल आपके होम नेटवर्क पर पहुँच में है। आपके लौटने तक जवाब रुके रहते हैं, या Tailscale चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Mac è raggiungibile solo sulla rete di casa. Le risposte attendono il tuo ritorno, oppure attiva Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac には自宅のネットワークからのみ接続できます。戻るまで回答は待機するか、Tailscale をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 집 네트워크에서만 연결할 수 있습니다. 돌아올 때까지 답변을 기다리거나 Tailscale을 켜세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac só é acessível na sua rede doméstica. As respostas esperam você voltar, ou ative o Tailscale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 仅能在家庭网络中访问。你回来之前回答会等待，或开启 Tailscale。"
          }
        }
      }
    },
