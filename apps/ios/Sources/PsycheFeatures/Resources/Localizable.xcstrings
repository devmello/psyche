    "The security code should match the one on your Mac. If it ever differs, pair again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يطابق رمز الأمان الرمز الظاهر على جهاز Mac. إذا اختلف يومًا، فأعد الإقران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitscode sollte mit dem auf deinem Mac übereinstimmen. Weicht er einmal ab, koppelst du neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security code should match the one on your Mac. If it ever differs, pair again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de seguridad debe coincidir con el de tu Mac. Si alguna vez difiere, vuelve a vincular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de sécurité doit correspondre à celui de votre Mac. S'il diffère un jour, associez à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा कोड आपके Mac पर दिखने वाले कोड से मेल खाना चाहिए। अगर कभी अलग हो, तो दोबारा पेयर करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di sicurezza deve corrispondere a quello sul tuo Mac. Se un giorno è diverso, abbina di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティコードはMacに表示されるものと一致するはずです。違う場合は、もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 코드는 Mac에 표시된 코드와 같아야 합니다. 다르면 다시 페어링하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de segurança deve ser igual ao do seu Mac. Se um dia for diferente, emparelhe de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全码应与你 Mac 上显示的一致。如果不一致，请重新配对。"
          }
        }
      }
    },
