    "Receipts appear here when Psyche acts for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipts appear here when Psyche acts for you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الإيصالات هنا عندما يتصرف Psyche نيابةً عنك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege erscheinen hier, wenn Psyche für dich etwas erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recibos aparecen aquí cuando Psyche actúa por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reçus apparaissent ici quand Psyche agit pour vous."
