    "Couldn't undo this. It changed after it was applied.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التراجع عن هذا. فقد تغيّر بعد تطبيقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ließ sich nicht rückgängig machen. Es wurde nach dem Anwenden geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't undo this. It changed after it was applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo deshacer. Cambió después de aplicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’annuler. Cela a changé après l’application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पूर्ववत नहीं किया जा सका। लागू करने के बाद यह बदल गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile annullare. È cambiato dopo l’applicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せませんでした。適用後に変更されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 취소할 수 없습니다. 적용한 뒤에 변경되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desfazer. Mudou depois de aplicado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销。应用之后它已发生变化。"
          }
        }
      }
    },
    "The draft was saved but not sent. Nothing left your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ المسودة لكن لم يتم إرسالها. لم يغادر شيء جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwurf wurde gesichert, aber nicht gesendet. Nichts hat deinen Mac verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft was saved but not sent. Nothing left your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador se guardó pero no se envió. No salió nada de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon est enregistré mais n’a pas été envoyé. Rien n’a quitté votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मसौदा सहेजा गया लेकिन भेजा नहीं गया। आपके Mac से कुछ भी बाहर नहीं गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza è stata salvata ma non inviata. Dal tuo Mac non è uscito nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きは保存されましたが、送信されていません。Macから何も送られていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안은 저장되었지만 전송되지 않았습니다. Mac에서 나간 것은 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rascunho foi salvo, mas não foi enviado. Nada saiu do seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存但未发送。没有任何内容离开你的 Mac。"
          }
        }
      }
    },
    "The draft was saved. The send may not have gone through: check Mail.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ المسودة. قد لا يكون الإرسال قد تم: تحقق من تطبيق البريد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwurf wurde gesichert. Das Senden ist möglicherweise nicht durchgegangen: Prüfe Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft was saved. The send may not have gone through: check Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador se guardó. Puede que el envío no se haya completado: revisa Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon est enregistré. L’envoi n’a peut-être pas abouti : vérifiez Mail."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मसौदा सहेजा गया। हो सकता है भेजना पूरा न हुआ हो: Mail में जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza è stata salvata. L’invio potrebbe non essere andato a buon fine: controlla Mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きは保存されました。送信が完了していない可能性があります。メールを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안이 저장되었습니다. 전송이 완료되지 않았을 수 있으니 Mail을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rascunho foi salvo. O envio pode não ter sido concluído: confira o Mail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存。发送可能未成功：请在“邮件”中确认。"
          }
        }
      }
    },
