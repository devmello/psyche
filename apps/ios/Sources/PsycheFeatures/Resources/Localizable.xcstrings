    "Allow the microphone and speech recognition for Psyche in Settings to dictate.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone and speech recognition for Psyche in Settings to dictate."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالميكروفون والتعرف على الكلام لـ Psyche في الإعدادات لإملاء النص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Psyche in den Einstellungen Mikrofon und Spracherkennung, um zu diktieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono y el reconocimiento de voz para Psyche en Ajustes para dictar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise le microphone et la reconnaissance vocale pour Psyche dans Réglages pour dicter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिक्टेशन के लिए सेटिंग्स में Psyche को माइक्रोफ़ोन और स्पीच पहचान की अनुमति दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Psyche il microfono e il riconoscimento vocale nelle Impostazioni per dettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、設定で Psyche のマイクと音声認識を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 하려면 설정에서 Psyche의 마이크와 음성 인식을 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o microfone e o reconhecimento de voz para o Psyche em Ajustes para ditar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Psyche 使用麦克风和语音识别以进行听写。"
          }
        }
      }
    },
