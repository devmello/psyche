    "“%@” stops shaping what Psyche does.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” stops shaping what Psyche does."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” لم يعد يؤثر في ما تفعله Psyche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ beeinflusst nicht mehr, was Psyche tut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” deja de influir en lo que hace Psyche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'influence plus ce que fait Psyche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” अब Psyche के काम को प्रभावित नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non influisce più su ciò che fa Psyche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は Psyche の動作に影響しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 더 이상 Psyche의 동작에 영향을 주지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” deixa de influenciar o que a Psyche faz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 不再影响 Psyche 的行为。"
          }
        }
      }
    },
