        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは iPhone では開けません。Mac の Psyche で読んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 휴대폰에서 열리지 않습니다. Mac의 Psyche에서 읽으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não abre no seu telefone. Leia no Psyche no seu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个内容无法在手机上打开。请在 Mac 上的 Psyche 中阅读。"
          }
        }
      }
    },
    "This phone can clear its keys and saved data now, but your Mac will keep listing it until you remove it in Settings → Devices there.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can clear its keys and saved data now, but your Mac will keep listing it until you remove it in Settings → Devices there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لهذا الهاتف مسح مفاتيحه وبياناته المحفوظة الآن، لكن جهاز Mac سيواصل عرضه حتى تزيله من الإعدادات ← الأجهزة هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann jetzt seine Schlüssel und gespeicherten Daten löschen. Dein Mac zeigt es aber weiter an, bis du es dort unter Einstellungen → Geräte entfernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono puede borrar ahora sus claves y datos guardados, pero tu Mac lo seguirá mostrando hasta que lo quites en Ajustes → Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone peut maintenant effacer ses clés et données enregistrées, mais ton Mac continuera de l'afficher jusqu'à ce que tu le retires dans Réglages → Appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन अभी अपनी कुंजियाँ और सहेजा गया डेटा मिटा सकता है, लेकिन जब तक आप उसे वहाँ सेटिंग्स → Devices से नहीं हटाते, आपका Mac उसे दिखाता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono può ora cancellare chiavi e dati salvati, ma il Mac continuerà a mostrarlo finché non lo rimuovi da Impostazioni → Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は鍵と保存データを消去できますが、Mac 側で「設定」→「デバイス」から削除するまで Mac に表示され続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 지금 키와 저장된 데이터를 지울 수 있지만, Mac에서 설정 → 기기에서 제거하기 전까지 Mac에 계속 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone pode apagar suas chaves e dados salvos agora, mas seu Mac continuará listando-o até você removê-lo em Ajustes → Dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机现在可以清除其密钥和已保存的数据，但在你的 Mac 上于“设置”→“设备”中移除之前，Mac 仍会列出它。"
          }
        }
      }
    },
