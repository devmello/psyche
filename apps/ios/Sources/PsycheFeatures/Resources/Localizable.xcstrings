    "Its automations pause and its folders stop working. You can restore it any time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف أتمتته وتتوقف مجلداته عن العمل. يمكنك استعادته في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Automatisierungen pausieren, und seine Ordner funktionieren nicht mehr. Du kannst ihn jederzeit wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its automations pause and its folders stop working. You can restore it any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus automatizaciones se pausan y sus carpetas dejan de funcionar. Puedes restaurarlo en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses automatisations sont suspendues et ses dossiers ne fonctionnent plus. Vous pouvez le restaurer à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके ऑटोमेशन रुक जाएँगे और इसके फ़ोल्डर काम करना बंद कर देंगे। आप इसे कभी भी वापस ला सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue automazioni si fermano e le sue cartelle smettono di funzionare. Puoi ripristinarlo in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化は一時停止し、フォルダは使えなくなります。いつでも復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화가 일시 중지되고 폴더가 작동하지 않습니다. 언제든지 복원할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As automações são pausadas e as pastas deixam de funcionar. Você pode restaurá-lo a qualquer momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其自动化将暂停，其文件夹也将停止工作。你随时可以恢复。"
          }
        }
      }
    },
    "Archived. Its automations are paused and its folders are off.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤرشف. أتمتته متوقفة ومجلداته معطّلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviert. Seine Automatisierungen sind pausiert und seine Ordner aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived. Its automations are paused and its folders are off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivado. Sus automatizaciones están pausadas y sus carpetas, desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivé. Ses automatisations sont suspendues et ses dossiers désactivés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहित। इसके ऑटोमेशन रुके हुए हैं और फ़ोल्डर बंद हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviato. Le sue automazioni sono in pausa e le cartelle disattivate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済み。自動化は一時停止中で、フォルダは無効です。"
          }
