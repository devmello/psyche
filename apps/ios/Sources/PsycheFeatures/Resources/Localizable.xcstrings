    "notice.machine.added.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافة {name} كجهاز كمبيوتر يمكن لـ Psyche استخدامه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} wurde als Computer hinzugefügt, den Psyche nutzen kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} was added as a computer Psyche can use"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} se añadió como un ordenador que Psyche puede usar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} a été ajouté comme ordinateur que Psyche peut utiliser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} को ऐसे कंप्यूटर के रूप में जोड़ा गया जिसे Psyche इस्तेमाल कर सकता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} è stato aggiunto come computer che Psyche può usare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}を Psyche が使えるコンピュータとして追加しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}이(가) Psyche가 사용할 수 있는 컴퓨터로 추가되었습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} foi adicionado como um computador que o Psyche pode usar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 {name} 添加为 Psyche 可以使用的电脑"
          }
        }
      }
    },
    "notice.machine.added.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Psyche استخدام شاشته وتطبيقاته وطرفيته وملفاته، وكل إجراء هناك يطلب موافقتك أولاً. إن لم تكن أنت من أضافه، فأزِله من الإعدادات ← الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche kann dort Bildschirm, Apps, Shell und Dateien nutzen, und jede Aktion fragt zuerst bei dir nach. Wenn du ihn nicht hinzugefügt hast, entferne ihn unter Einstellungen → Geräte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche can use its screen, apps, shell and files, and each action there asks you first. If you didn't add it, remove it in Settings → Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche puede usar su pantalla, aplicaciones, shell y archivos, y cada acción allí te pide permiso antes. Si no lo añadiste tú, quítalo en Ajustes → Dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche peut utiliser son écran, ses apps, son shell et ses fichiers, et chaque action vous demande d'abord. Si ce n'est pas vous qui l'avez ajouté, retirez-le dans Réglages → Appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche इसकी स्क्रीन, ऐप, शेल और फ़ाइलें इस्तेमाल कर सकता है, और वहाँ हर कार्रवाई पहले आपसे पूछती है। अगर आपने इसे नहीं जोड़ा, तो सेटिंग → डिवाइस में इसे हटा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche può usare il suo schermo, le app, la shell e i file, e ogni azione lì chiede prima a te. Se non l'hai aggiunto tu, rimuovilo in Impostazioni → Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche はその画面、アプリ、シェル、ファイルを使えますが、そこでの操作はそのつど先に確認します。心当たりがない場合は、設定 → デバイスから削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche는 이 컴퓨터의 화면, 앱, 셸, 파일을 사용할 수 있으며, 그곳에서의 모든 동작은 먼저 사용자에게 확인을 요청합니다. 직접 추가한 것이 아니라면 설정 → 기기에서 삭제하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche pode usar a tela, os apps, o shell e os arquivos dele, e cada ação lá pede sua confirmação antes. Se não foi você que adicionou, remova em Ajustes → Dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 可以使用它的屏幕、应用、终端和文件，且那里的每个操作都会先征求你的同意。如果不是你添加的，请在“设置 → 设备”中移除。"
          }
        }
      }
    },
    "notice.machine.removed.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزال {name} نفسه"
