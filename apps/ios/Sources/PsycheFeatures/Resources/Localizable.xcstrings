    "Changes Psyche made on its own in the last week. Undo any of them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes Psyche made on its own in the last week. Undo any of them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغييرات أجراها Psyche من تلقاء نفسه خلال الأسبوع الماضي. يمكنك التراجع عن أيٍّ منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen, die Psyche in der letzten Woche von selbst vorgenommen hat. Du kannst jede rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios que Psyche hizo por su cuenta en la última semana. Puedes deshacer cualquiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changements faits par Psyche de sa propre initiative la semaine dernière. Vous pouvez tous les annuler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले एक हफ़्ते में Psyche ने अपने आप किए बदलाव। इनमें से किसी को भी वापस लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiche fatte da Psyche da sola nell'ultima settimana. Puoi annullarne qualsiasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 1 週間に Psyche が自動で行った変更です。いずれも取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 일주일 동안 Psyche가 자동으로 바꾼 내용입니다. 각각 되돌릴 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudanças que a Psyche fez por conta própria na última semana. Desfaça qualquer uma delas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche 上周自行做出的更改。可以撤销任一项。"
          }
        }
      }
    },
