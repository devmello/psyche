    "Psyche isn't set up to receive shares in this build.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche isn't set up to receive shares in this build."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعدّ Psyche لاستقبال المشاركات في هذا الإصدار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche ist in dieser Version nicht für den Empfang von Freigaben eingerichtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche no está configurado para recibir contenido compartido en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche n'est pas configuré pour recevoir des partages dans cette version."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संस्करण में Psyche साझा सामग्री प्राप्त करने के लिए सेट नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Psyche non è configurato per ricevere condivisioni in questa versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドでは Psyche で共有を受け取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 Psyche가 공유 항목을 받도록 설정되어 있지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Psyche não está configurado para receber compartilhamentos nesta versão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Psyche 未设置接收分享内容。"
          }
        }
      }
    },
    "Couldn't save that to send. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save that to send. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ ذلك للإرسال. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte zum Senden nicht gespeichert werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar para enviar. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer cet envoi. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने के लिए सहेजा नहीं जा सका। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare per l'invio. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信用に保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 항목을 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar para enviar. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存要发送的内容，请重试。"
          }
        }
      }
    },
