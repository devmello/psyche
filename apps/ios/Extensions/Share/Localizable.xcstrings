    "Shared content is untrusted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared content is untrusted"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحتوى المشارَك غير موثوق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilte Inhalte sind nicht vertrauenswürdig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido compartido no es de confianza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu partagé n'est pas fiable"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा की गई सामग्री पर भरोसा नहीं है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto condiviso non è attendibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された内容は信頼できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 내용은 신뢰할 수 없습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo compartilhado não é confiável"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的内容不可信"
          }
        }
      }
    },
