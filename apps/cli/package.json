{
  "name": "@psyche/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The psyche CLI; talks only to the Gateway API.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@psyche/backup": "workspace:*",
    "@psyche/permissions": "workspace:*",
    "@psyche/protocol": "workspace:*"
  },
  "devDependencies": {
    "@psyche/gateway": "workspace:*",
    "@psyche/testing": "workspace:*",
    "@psyche/web": "workspace:*"
  },
  "bin": {
    "psyche": "./src/main.ts"
  }
}
