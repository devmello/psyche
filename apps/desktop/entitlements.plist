<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID build (docs/signing.md).
  Keep this minimal:
  - allow-jit: V8 needs it under the hardened runtime. As of Electron 44 it is the only
    code-signing exception @electron/osx-sign's defaults give the app and its helpers;
    allow-unsigned-executable-memory is not needed.
  - audio-input: microphone for dictation (paired with NSMicrophoneUsageDescription).
  - personal-information.calendars / addressbook and automation.apple-events: macOS attributes the
    bundled helper's Reminders, Calendar, Contacts and Apple Events requests to this outer bundle
    (#570), so without these the hardened runtime denies them silently and no prompt appears.
  - No disable-library-validation: node-pty's pty.node and spawn-helper are signed with the app.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
