{
  "name": "@psyche/desktop",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "Electron desktop shell",
  "productName": "Psyche",
  "license": "Apache-2.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build:e2e": "electron-forge package"
  },
  "dependencies": {
    "@psyche/protocol": "workspace:*",
    "@psyche/ui": "workspace:*",
    "@psyche/viewers": "workspace:*",
    "@psyche/web": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@psyche/testing": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "tailwindcss": "4.3.3",
    "ws": "8.22.0"
  }
}
