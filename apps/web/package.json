{
  "name": "@psyche/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web client served by the Gateway",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "default": "./src/shell/index.ts"
    },
    "./testing": {
      "types": "./testing/index.ts",
      "default": "./testing/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@psyche/protocol": "workspace:*",
    "@psyche/ui": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@psyche/gateway": "workspace:*",
    "@psyche/testing": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.3",
    "ws": "8.22.0"
  }
}
