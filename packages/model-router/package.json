{
  "name": "@psyche/model-router",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "Provider adapters on AI SDK v7, the router (roles, fallbacks, cooldowns), usage ledger, price table, capability probe.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prices:update": "node scripts/prices-update.ts",
    "smoke:deferred-tools": "node scripts/smoke-deferred-tools.ts",
    "test:live": "PSYCHE_LIVE_TESTS=1 vitest run test/live.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.125",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/provider": "4.0.39",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@psyche/assets": "workspace:*",
    "@psyche/hostfs": "workspace:*",
    "@psyche/protocol": "workspace:*",
    "ai": "7.0.181",
    "ollama-ai-provider-v2": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@psyche/db": "workspace:*",
    "@psyche/testing": "workspace:*"
  }
}
