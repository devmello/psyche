{
  "name": "@psyche/browser",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "Agent browser: BrowserDriver over the desktop CDP bridge and Playwright, snapshots, origin policy, browser.* tools",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance/index.ts",
      "default": "./src/conformance/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@psyche/protocol": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@psyche/testing": "workspace:*",
    "vitest": "5.0.5"
  }
}
