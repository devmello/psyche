import { PsycheError } from "@psyche/protocol";
import { beforeEach, describe, expect, it, vi } from "vitest";

const launch = vi.fn();
vi.mock("playwright-core", () => ({ chromium: { launch, launchPersistentContext: launch } }));

const { PlaywrightDriver } = await import("../src/drivers/playwright.ts");

async function open(driver: InstanceType<typeof PlaywrightDriver>): Promise<unknown> {
  try {
    await driver.openSession({});
    return undefined;
  } catch (e) {
    return e;
  }
}

describe("Playwright driver sandbox", () => {
  beforeEach(() => launch.mockReset());

  it("passes chromiumSandbox: true to the launch when asked", async () => {
    launch.mockRejectedValue(new Error("boom"));
    await open(new PlaywrightDriver({ library: {} as never, chromiumSandbox: true }));
    expect(launch).toHaveBeenCalled();
    expect(launch.mock.calls[0]?.at(-1)).toMatchObject({ chromiumSandbox: true });
  });

  it("fails closed with unavailable/chromium_sandbox when the sandbox cannot start", async () => {
    launch.mockRejectedValue(new Error("No usable sandbox! Operation not permitted"));
    const err = await open(new PlaywrightDriver({ library: {} as never, chromiumSandbox: true }));
    expect(err).toBeInstanceOf(PsycheError);
    expect(err).toMatchObject({ code: "unavailable", details: { reason: "chromium_sandbox" } });
  });

  it("does not set the option unasked", async () => {
    launch.mockRejectedValue(new Error("No usable sandbox!"));
    await open(new PlaywrightDriver({ library: {} as never }));
    expect(launch.mock.calls[0]?.at(-1)).not.toHaveProperty("chromiumSandbox");
  });
});
