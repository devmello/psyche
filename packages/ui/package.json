{
  "name": "@psyche/ui",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "React components: message blocks, cards, screens, theme.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    },
    "./testing": {
      "types": "./src/data/mock-gateway.ts",
      "default": "./src/data/mock-gateway.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --fsModuleCache=false",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots",
    "gen:theme": "tsx scripts/gen-default-theme.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.29",
    "@base-ui/react": "1.9.0",
    "@psyche/permissions": "workspace:*",
    "@psyche/protocol": "workspace:*",
    "@tanstack/react-table": "9.3.1",
    "bezier-easing": "3.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "colorjs.io": "0.7.1",
    "intl-messageformat": "12.1.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@psyche/testing": "workspace:*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3"
  }
}
