{
  "name": "@psyche/protocol",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "Psyche protocol: TypeBox schemas, WS frames, method/event registry, node and browser-bridge protocol, codegen and the cross-package contract interfaces",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "default": "./src/platform.ts"
    },
    "./host-words": {
      "types": "./src/host-words.ts",
      "default": "./src/host-words.ts"
    },
    "./money-intent": {
      "types": "./src/money-intent.ts",
      "default": "./src/money-intent.ts"
    },
    "./financial-block": {
      "types": "./src/financial-block.ts",
      "default": "./src/financial-block.ts"
    },
    "./binding": {
      "types": "./src/binding.ts",
      "default": "./src/binding.ts"
    },
    "./claim-node": {
      "types": "./src/claim-node.ts",
      "default": "./src/claim-node.ts"
    },
    "./routine-path": {
      "types": "./src/routine-path.ts",
      "default": "./src/routine-path.ts"
    },
    "./schema.json": "./generated/schema.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "gen": "tsx scripts/gen.ts",
    "gen:check": "tsx scripts/gen.ts --check"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "quicktype-core": "26.0.0"
  }
}
