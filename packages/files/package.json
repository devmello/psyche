{
  "name": "@psyche/files",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "P9 file tools for the agent: read_file (with PDF, DOCX and XLSX text extraction), write_file, edit_file, list_dir and search_files over granted folders.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@psyche/agent-core": "workspace:*",
    "@psyche/assets": "workspace:*",
    "@psyche/protocol": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "pdfjs-dist": "6.4.299"
  },
  "files": [
    "src"
  ]
}
