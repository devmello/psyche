{
  "name": "@psyche/testing",
  "version": "0.0.0",
  "private": true,
  "description": "In-memory fakes, fixtures, conformance suites and the secret-leak checker",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance/index.ts",
      "default": "./src/conformance/index.ts"
    },
    "./resumability": {
      "types": "./src/resumability/index.ts",
      "default": "./src/resumability/index.ts"
    },
    "./vitest": {
      "types": "./src/vitest.ts",
      "default": "./src/vitest.ts"
    },
    "./vitest-setup": {
      "types": "./src/vitest-setup.ts",
      "default": "./src/vitest-setup.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@psyche/protocol": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "ulid": "3.0.2"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "bin": {
    "psyche-check-secrets": "./src/cli/check-secrets.ts"
  }
}
