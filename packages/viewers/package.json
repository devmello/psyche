{
  "name": "@psyche/viewers",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "PDF, sheets, DOCX, code, Markdown editor, artifact frame, extraction, generators.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./core/detect": {
      "types": "./src/core/detect.ts",
      "default": "./src/core/detect.ts"
    },
    "./core/convert": {
      "types": "./src/core/convert.ts",
      "default": "./src/core/convert.ts"
    },
    "./bundler": {
      "types": "./src/bundler/index.ts",
      "default": "./src/bundler/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@babel/standalone": "8.0.9",
    "@cantoo/pdf-lib": "2.11.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codesandbox/sandpack-client": "2.19.8",
    "@lezer/highlight": "1.2.5",
    "@psyche/protocol": "workspace:*",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.22",
    "@univerjs/core": "1.2.0",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "docx": "9.14.0",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "postal-mime": "4.1.4",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "shiki": "4.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@psyche/testing": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1"
  }
}
