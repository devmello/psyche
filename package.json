{
  "name": "psyche",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hosted personal AI agent for macOS and your own server",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "protocol:gen": "pnpm --filter @psyche/protocol run gen",
    "protocol:check": "pnpm --filter @psyche/protocol run gen:check",
    "changeset": "changeset",
    "check:secrets": "tsx packages/testing/src/cli/check-secrets.ts",
    "check:injection": "tsx packages/testing/src/cli/run-injection.ts",
    "check:resumability": "pnpm --filter @psyche/testing exec vitest run test/resumability.test.ts",
    "check:scenarios": "tsx packages/testing/src/scenarios/cli.ts --out out/security/scenarios-report.json",
    "docs:dev": "pnpm --filter @psyche/site docs:dev",
    "docs:build": "pnpm --filter @psyche/site docs:build",
    "docs:check": "pnpm --filter @psyche/site docs:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
