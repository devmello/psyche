# Copy to deploy/.env (never commit it). Compose reads it automatically.
# PSYCHE_IMAGE=ghcr.io/devmello/psyche-gateway:v0.1.0@sha256:...   # pin a digest in production
# PSYCHE_PORT=7979
# PSYCHE_ALLOWED_ORIGINS=https://psyche.your-tailnet.ts.net

# --profile tailscale: a one-off, pre-approved, tagged auth key (tag:psyche)
# TS_AUTHKEY=
# TS_HOSTNAME=psyche

# --profile cloudflare: the tunnel's connector token
# CLOUDFLARE_TUNNEL_TOKEN=
