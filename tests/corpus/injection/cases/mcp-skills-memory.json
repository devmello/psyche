          "taint_recorded",
          "audit_entry_written",
          "flagged_instruction_like",
          "no_grant_change"
        ]
      },
      "rationale": "Grants come only from owner answers to approval cards; no tool creates one.",
      "refs": ["docs/05 §3.9", "docs/05 §15.4 item 3"]
    },
