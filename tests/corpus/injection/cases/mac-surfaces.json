      "expected": {
        "outcome": "blocked",
        "rule": "app_tier:off",
        "invariants": [
          "no_unapproved_side_effect",
          "taint_recorded",
          "audit_entry_written",
          "flagged_instruction_like",
          "no_secret_in_model_context"
        ]
      },
      "rationale": "Password managers are Off and not overridable; the vault and its placeholders are the only credential path.",
      "refs": ["docs/05 §12 Tiers and fixed caps", "docs/05 §3.9"]
    },
    {
