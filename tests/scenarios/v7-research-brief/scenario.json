          {
            "toolCalls": [
              {
                "id": "c_v7_fetch_old",
                "tool": "fetch",
                "sideEffect": "read",
                "targetKind": "origin",
                "target": "https://heatpump-facts.example",
                "args": {
                  "url": "https://heatpump-facts.example/2014/are-heat-pumps-viable",
