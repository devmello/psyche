  "permissions": {
    "defaultMode": "balanced",
    "approvals": {
      "ttlMinutes": 30
    },
    "$comment": "Connector matrices list only what the owner set explicitly. `allow` acts as a standing grant for that action; an unset action falls through to the mode default (docs/05 \u00a73.2-\u00a73.3). gmail.draft and calendar writes are deliberately unset: in balanced they ask, and the scenarios check that a `task` grant from the first card covers later drafts. Apple app matrices follow the connector plan \u00a73: reads allow, writes ask, sends ask and never allow.",
    "connectors": {
      "google": {
        "gmail.read": "allow",
        "gmail.send": "ask",
        "gmail.delete": "deny",
        "calendar.read": "allow",
        "calendar.delete": "ask",
        "drive.write": "deny"
      },
      "search:brave": {
        "search.web": "allow"
      },
      "shopping": {
        "shop.compare": "allow",
        "shop.view_cart": "allow"
      },
      "travel": {
        "travel.search_flights": "allow"
      },
      "apple:mail": {
        "mail_search": "allow",
        "mail_read": "allow",
        "mail_set_flags": "ask",
        "mail_forward_draft": "ask",
        "mail_send_draft": "ask"
      },
      "apple:reminders": {
        "reminders_create": "ask"
      },
      "apple:calendar": {
        "calendar_list_events": "allow"
      },
      "apple:contacts": {
        "contacts_search": "allow"
      },
      "apple:notes": {
        "notes_search": "allow",
        "notes_read": "allow",
        "notes_create": "ask",
        "notes_append": "ask"
      }
    },
    "standingGrants": [
      {
        "id": "grt_fx_energy_agency",
        "scope": "site",
        "kind": "new_origin",
        "subject": {
          "origin": "https://energy-agency.example"
        },
        "createdAt": "2026-10-02T17:12:00Z",
        "expiresAt": "2026-11-01T17:12:00Z",
        "uses": 3,
        "$comment": "Read grant from an earlier research task; V7 checks that it is honored (no card)."
      }
    ]
  },
  "connectors": [
    {
      "id": "con_google",
      "type": "google",
      "account": "owner@example.com",
      "scopeMode": "read_act",
