      "type": "apple:contacts",
      "account": "dev_mbp",
      "scopeMode": "read_act",
      "$comment": "Local helper on the paired Mac (Contacts access); a TCC grant, no credential."
    },
    {
      "id": "con_apple_notes",
      "type": "apple:notes",
      "account": "dev_mbp",
      "scopeMode": "read_act",
      "$comment": "Local helper on the paired Mac (Automation: Notes); a TCC grant, no credential."
