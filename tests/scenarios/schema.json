    "killPoint": {
      "type": "object",
      "required": ["id", "at", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "at": {
          "type": "string",
          "pattern": "^(after_model_event:[0-9]+|before_dispatch:[a-z0-9_.-]+|before_receipt:[a-z0-9_.-]+|after_receipt:[a-z0-9_.-]+|while_awaiting_approval:[a-z0-9_.-]+)$"
        },
        "expect": {
          "type": "object",
          "required": ["outcome", "assertions"],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": ["resumes", "reissues_approval", "reconciles_uncertain", "replays_safe_read"]
            },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/assertion" }
            },
            "note": { "type": "string", "minLength": 1 }
          }
