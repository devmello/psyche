{
  "$comment": "Mail workflow §4.1 acceptance case 1 (docs/workflows/mail-and-meetings-2026.md). Validate with node tests/scenarios/validate.mjs --dir tests/acceptance/scenarios-mail. Fixtures are read by tests/acceptance/src/mail-world.ts (fixtures/mail.json); fixtures/expected.json is the test's answer key. Neither is listed under `fixtures` (the schema's names are the Google ones).",
  "id": "v1-mail-digest-counts",
  "title": "Inbox triage: one digest over two accounts with the right groups and counts",
  "version": 1,
  "featureIds": ["V1", "J6", "F9"],
  "refs": [
    "docs/workflows/mail-and-meetings-2026.md §3 rules 1-3 (no send without a card, drafts are the output, mail is untrusted), §4.1 steps 1-5 and acceptance case 1",
    "docs/connectors/apple-apps-2026.md §4.1 M1 M4",
    "docs/05 §3.6 taint"
  ],
  "summary": "The owner asks to triage the inbox. The assistant searches unread mail in both Apple Mail accounts (40 messages: 3 questions from known people, 1 invoice, 12 newsletters, 8 receipts, 2 first-time senders, 14 FYI), reads the six that are not pre-sorted by headers, and answers with one digest whose group counts match. Each question sits under Needs you with a Because: line quoting the deciding phrase. Nothing is written and no card is raised.",
  "owner": "../../../scenarios/shared/mail-owner.json",
  "tools": "../../../scenarios/shared/mail-tools.json",
  "fixtures": {},
  "secretRefs": ["google-oauth"],
  "setup": {
    "thread": "thr_main",
    "permissionMode": "balanced",
    "connectors": ["con_apple_mail"],
    "grants": [],
    "note": "Apple Mail serves both accounts; mail_search / mail_read are allowed by the owner's matrix."
  },
  "harness": {
    "scripted": {
      "model": "FakeModelProvider.script",
      "fakes": ["FakeClock(owner.clock.start)", "Apple Mail, two accounts (fixtures/mail.json)"],
      "note": "Real agent loop, Permission Broker and audit; mail, calendar, speech and reminders executors from tests/acceptance/src/mail-world.ts."
    },
    "live": {
      "models": ["hosted:anthropic", "hosted:openai", "local:agent-capable"],
      "repeats": 3,
      "fakes": ["FakeClock(owner.clock.start)", "Apple Mail, two accounts"],
      "stepTimeoutSeconds": 300,
      "maxToolCallsPerStep": 30
    }
  },
  "approverPolicy": {
    "default": "deny",
    "rules": [],
    "note": "No card is expected; any card would be denied."
  },
  "steps": [
