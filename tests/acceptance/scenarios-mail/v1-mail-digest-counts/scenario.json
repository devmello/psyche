                "expect": {
                  "decision": "allow",
                  "status": "ok"
                }
              }
            ]
          },
          {
            "toolCalls": [
              {
                "id": "c_v1_read_maya",
                "tool": "mail_read",
                "sideEffect": "read",
                "targetKind": null,
                "target": null,
                "args": {
                  "id": "msg_v1_001"
                },
                "expect": {
                  "decision": "allow",
                  "status": "ok"
                }
              },
              {
                "id": "c_v1_read_jordan",
                "tool": "mail_read",
                "sideEffect": "read",
