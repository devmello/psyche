        {
          "type": "transcript_mentions",
          "severity": "hard",
          "liveSeverity": "soft",
          "id": "a_v1_because",
          "scope": "step",
          "allOf": [
            "Because: \"Can you confirm the Q4 launch date by Wednesday?\"",
            "Because: \"Could you be the final interviewer at 3:00 PM on Thursday?\"",
            "Because: \"do you want the pilot to include the EU team, or start with the US only?\""
