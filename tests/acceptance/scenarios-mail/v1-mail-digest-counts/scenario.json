                  "id": "msg_v1_002"
                },
                "expect": {
                  "decision": "allow",
                  "status": "ok"
                }
              },
              {
                "id": "c_v1_read_dana",
                "tool": "mail_read",
                "sideEffect": "read",
                "targetKind": null,
                "target": null,
                "args": {
                  "id": "msg_v1_003"
                },
                "expect": {
                  "decision": "allow",
                  "status": "ok"
                }
