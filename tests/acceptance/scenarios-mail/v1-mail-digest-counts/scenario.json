                "target": null,
                "args": {
                  "account": "owner@example.com",
                  "unread": true,
                  "limit": 200
                },
                "expect": {
                  "decision": "allow",
                  "status": "ok"
                }
              },
              {
                "id": "c_v1_search_personal",
                "tool": "mail_search",
                "sideEffect": "read",
                "targetKind": null,
                "target": null,
                "args": {
                  "account": "avery.lin@example.net",
                  "unread": true,
                  "limit": 200
