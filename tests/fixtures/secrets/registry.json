  "patternSamples": {
    "$comment": "Values the leak checker must catch by PATTERN (security §4.4: Luhn + identifier patterns), even when not registered. `mustMatch` are positives; `mustNotMatch` are look-alikes that must not fire (false-positive guard).",
    "card": {
      "mustMatch": [
        "4242424242424242",
        "4242 4242 4242 4242",
        "4242-4242-4242-4242",
        "5555555555554444",
        "2223003122003222",
        "378282246310005",
        "3782 822463 10005",
        "6011111111111117",
        "4000056655665556"
      ],
      "mustNotMatch": [
        "4242424242424241",
        "1234567812345678",
        "2026-10-18T19:04:11",
        "order 18f3c2a9e7b1d4c0",
        "+1 415 555 0134",
        "1700000000000"
      ]
    },
    "us_ssn": {
      "mustMatch": ["078-05-1120", "219-09-9999", "SSN: 123-45-6789"],
      "mustNotMatch": ["000-12-3456", "666-12-3456", "2026-10-19", "415-555-0134 ext 2"]
    },
    "iban": {
      "mustMatch": [
        "GB82WEST12345698765432",
        "GB82 WEST 1234 5698 7654 32",
        "DE89370400440532013000"
      ],
      "mustNotMatch": ["GB82WEST12345698765433", "SHA256SUMS"]
    },
    "us_bank_account": {
      "mustMatch": ["routing 011000015 account 000123456789", "ABA 021000021 acct 1234567890"],
      "mustNotMatch": ["invoice 011000015", "order 000123456789"]
    },
    "passport": {
      "mustMatch": ["passport no. 963545637", "Passport Number: X12345678"],
      "mustNotMatch": ["flight 963545637", "booking X12345678"]
    },
    "private_key_block": {
      "$comment": "Written as {concat: [...]} so the repo's own secret-grep gate does not fire on this file; loaders join the parts.",
      "mustMatch": [
        {
          "concat": ["-----BEGIN OPENSSH ", "PRIVATE KEY-----"]
        },
        {
          "concat": ["-----BEGIN ", "PRIVATE KEY-----"]
        },
        {
          "concat": ["-----BEGIN RSA ", "PRIVATE KEY-----"]
        }
      ],
      "mustNotMatch": ["-----BEGIN PUBLIC KEY-----", "-----BEGIN CERTIFICATE-----"]
    },
    "placeholder_ok": {
      "$comment": "Placeholders ARE allowed in model-visible text (docs/05 §4.5); the checker must not flag them, but must flag their resolved values.",
