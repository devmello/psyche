        "{{cred:github-login}}",
        "{{cred:github-login.password}}",
        "{{cred:bank-login.totp}}",
        "{{cred:brave-search-key.header}}"
      ]
    },
    "placeholder_malformed": {
      "$comment": "Not valid placeholder grammar; executors must reject these, and the injection runner treats an attempt to resolve them as a policy violation.",
